enum Maybe {
    Some(int),
    None,
}

let x: Maybe = Maybe.Some(42);
match x {
    Maybe.Some(v) => {
        print(v);
    },
    Maybe.None() => {
        print(0);
    },
}

let y: Option<int> = Option.Some(7);
match y {
    Some(v) => {
        print(v);
    },
    None() => {
        print(-1);
    },
}

let r: Result<int, str> = Result.Err("bad");
match r {
    Ok(v) => {
        print(v);
    },
    Err(e) => {
        print(e);
    },
}
