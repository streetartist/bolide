// 局部闭包与闭包作为参数

fn apply(f: func(int) -> int, x: int) -> int {
    return f(x);
}

fn make_adder(n: int) -> func(int) -> int {
    return fn(x: int) -> int { return x + n; };
}

print(apply(fn(x: int) -> int { return x * 3; }, 7));

let add5 = make_adder(5);
print(add5(10));

let m: int = 4;
let timesM = fn(x: int) -> int { return x * m; };
print(timesM(6));
