// 测试 spawn all

fn task1() -> int {
    return 10;
}

fn task2() -> int {
    return 20;
}

fn task3() -> int {
    return 30;
}

// 并行运行多个任务并等待全部结果
let results: (int, int, int) = spawn all {
    task1(),
    task2(),
    task3()
};

print(results);
print(results[0]);
print(results[1]);
print(results[2]);

print(999);
