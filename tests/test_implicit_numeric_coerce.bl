// Implicit coercions for annotated storage / call args
let a: bigint = 1;
print(a);

let b: bigint = int(42);
print(b);

let c: decimal = 1;
print(c);

let d: decimal = 1.5;
print(d);

let e: float = 1;
print(e);

fn take_big(x: bigint) {
    print(x);
}
take_big(7);

let f: bigint = 10;
let g: bigint = f + 1B;
print(g);
