import "std/assert/assert.bl" as assert;

assert.reset();
assert.equal("string equal", "bolide", "bolide");
assert.equal("int equal", 42, 42);
assert.equal("float equal", 1.25, 1.25);
assert.equal("bool equal", true, true);
assert.is_true("is true", 3 > 1);
assert.is_false("is false", 1 > 3);
assert.contains("contains", "hello bolide", "bolide");
assert.not_contains("not contains", "hello bolide", "rust");

print(assert.summary() + "\n");
print("std assert done\n");
