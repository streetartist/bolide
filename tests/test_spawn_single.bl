// 单线程 spawn + await 测试

fn compute(x: bigint) -> bigint {
    let result: bigint = x + x + 1B;
    return result;
}

fn main_test() {
    let a: bigint = 100B;
    print("Before spawn:");
    bigint_debug_stats();

    let h: Task<bigint> = spawn thread compute(a);
    print("After spawn:");
    bigint_debug_stats();

    let r: bigint = await h;
    print("After await:");
    print(r);
    bigint_debug_stats();
}

main_test();
print("Final:");
bigint_debug_stats();
