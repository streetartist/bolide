fn mix(a: int, b: int = 2, c: int = 3) -> int {
    return a * 100 + b * 10 + c;
}

fn total(base: int = 10, *nums: int, **opts: int) -> int {
    let sum: int = base;
    for n in nums {
        sum += n;
    }
    if opts.contains("bonus") {
        sum += opts.get("bonus");
    }
    return sum;
}

fn greet(name: str = "world") {
    print(name);
}

class Point {
    x: int = 1;
    y: int = 2;

    fn score(dx: int = 10, dy: int = 20) -> int {
        return self.x + self.y + dx + dy;
    }
}

print(mix(1));
print(mix(c=9, a=1));
print(total());
print(total(1, 2, 3));

let xs: list<int> = [4, 5];
let opts: dict<str, int> = {"bonus": 6};
print(total(1, *xs, **opts));
print(total(base=5, bonus=7));

greet();
greet(name="bolide");

let p: Point = Point(y=4);
print(p.score(dy=5));
