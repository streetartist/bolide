import "std/sort/sort.bl" as sort;

fn check_int(name: str, got: int, want: int) {
    if got == want {
        print("ok " + name + "\n");
    } else {
        print("FAIL " + name + " got=" + str(got) + " want=" + str(want) + "\n");
    }
}

fn check_float(name: str, got: float, want: float) {
    if got == want {
        print("ok " + name + "\n");
    } else {
        print("FAIL " + name + " got=" + str(got) + " want=" + str(want) + "\n");
    }
}

fn check_str(name: str, got: str, want: str) {
    if got == want {
        print("ok " + name + "\n");
    } else {
        print("FAIL " + name + " got=" + got + " want=" + want + "\n");
    }
}

let ints: list<int> = [5, 1, 3, 1, 2];
sort.ints(ints);
check_int("int first", ints[0], 1);
check_int("int last", ints[4], 5);
check_int("binary hit", sort.binary_search(ints, 3), 3);
check_int("binary miss", sort.binary_search(ints, 9), -1);

let floats: list<float> = [3.5, 1.25, 2.0];
sort.floats(floats);
check_float("float first", floats[0], 1.25);
check_float("float last", floats[2], 3.5);

let strings: list<str> = ["pear", "apple", "banana"];
sort.strings(strings);
check_str("str first", strings[0], "apple");
check_str("str last", strings[2], "pear");

print("std sort done\n");
