// Catch bindings should shadow outer names without mutating them.

fn check(name: str, got: int, want: int) {
    if got == want {
        print("ok " + name);
    } else {
        print("FAIL " + name + " got=" + str(got) + " want=" + str(want));
    }
}

let err: int = 7;

try {
    throw Error("42");
} catch (err: Error) {
    check("catch shadow value", err.message.len(), 2);
}

check("outer after catch", err, 7);

try {
    throw Error("11");
} catch (e: Error) {
    let e: int = e.message.len() + 10;
    check("inner catch shadow", e, 12);
}

check("outer still intact", err, 7);

print("catch shadow done");
