print("=== test 1: basic try/catch ===");
try {
    print("in try body");
    throw Error("99");
    print("after throw (should not print)");
} catch (e: Error) {
    print("caught exception:");
    print(e.message);
}
print("after try/catch");

print("");
print("=== test 2: nested try/catch ===");
try {
    try {
        print("inner try");
        throw Error("42");
    } catch (e: Error) {
        print("inner catch:");
        print(e.message);
    }
    print("after inner try");
} catch (e: Error) {
    print("outer catch (should not reach)");
}
print("after nested try/catch");

print("");
print("=== test 3: rethrow propagates ===");
try {
    try {
        print("inner try");
        throw Error("77");
    } catch (e: Error) {
        print("inner catch, rethrowing:");
        print(e.message);
        throw e;
    }
} catch (e: Error) {
    print("outer catch:");
    print(e.message);
}
print("after propagate test");

print("");
print("=== test 4: no throw ===");
try {
    print("try with no throw");
} catch (e: Error) {
    print("should not reach");
}
print("after no-throw test");

print("");
print("=== done ===");
