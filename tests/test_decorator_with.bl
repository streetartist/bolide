// Python 风格装饰器 + with 上下文管理器

// ---------- 装饰器：deco(f) -> f ----------
fn logged(f: func() -> int) -> func() -> int {
    return fn() -> int {
        print("before");
        let r: int = f();
        print("after");
        return r;
    };
}

@logged
fn answer() -> int {
    return 42;
}
print(answer());

fn twice(f: func(int) -> int) -> func(int) -> int {
    return fn(x: int) -> int {
        return f(f(x));
    };
}

@twice
fn inc(x: int) -> int {
    return x + 1;
}
print(inc(1));  // 3

// 装饰器工厂 @repeat(n)
fn repeat(n: int) -> func(func() -> int) -> func() -> int {
    return fn(f: func() -> int) -> func() -> int {
        return fn() -> int {
            var i: int = 0;
            var last: int = 0;
            while i < n {
                last = f();
                i = i + 1;
            }
            return last;
        };
    };
}

@repeat(3)
fn step() -> int {
    print("step");
    return 1;
}
print(step());

// 多层 @a @b ⇒ a(b(raw))
fn tag_a(f: func() -> int) -> func() -> int {
    return fn() -> int {
        print("A");
        return f();
    };
}
fn tag_b(f: func() -> int) -> func() -> int {
    return fn() -> int {
        print("B");
        return f();
    };
}

@tag_a
@tag_b
fn nested() -> int {
    return 7;
}
print(nested());

// ---------- with ----------
class Resource {
    name: str;
    open: int = 0;

    fn enter() -> str {
        self.open = 1;
        print("enter");
        return self.name;
    }

    fn exit() {
        self.open = 0;
        print("exit");
    }
}

with Resource("db") as r {
    print(r);
}
print("after with");

class Flag {
    fn enter() { print("flag on"); }
    fn exit() { print("flag off"); }
}

with Flag() {
    print("inside");
}

class A {
    fn enter() -> int { print("A in"); return 1; }
    fn exit() { print("A out"); }
}
class B {
    fn enter() -> int { print("B in"); return 2; }
    fn exit() { print("B out"); }
}

with A() as x, B() as y {
    print(x);
    print(y);
}

print("deco_with_ok");
