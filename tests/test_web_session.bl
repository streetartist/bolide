import "std/web/web.bl";

fn visit(req: web.Request) -> web.Response {
    let res: web.Response = web.text("visit");
    let session: web.Session = web.session(req, res);

    if session.contains("count") {
        let current: dynamic = session.get("count");
        print(current);
        let next: dynamic = 2;
        session.set("count", next);
    } else {
        let first: dynamic = 1;
        session.set("count", first);
    }

    res.set_cookie("theme", "dark", "/", -1, true, "Lax");
    print(req.cookie("theme"));
    session.free();
    return res;
}

fn rotate(req: web.Request) -> web.Response {
    let res: web.Response = web.text("rotate");
    let session: web.Session = web.session(req, res);
    let old_id: str = session.id();
    let new_id: str = session.regenerate(res);
    print(old_id == new_id);
    session.free();
    return res;
}

fn logout(req: web.Request) -> web.Response {
    let res: web.Response = web.text("logout");
    let session: web.Session = web.session(req, res);
    print(session.destroy(res));
    session.free();
    return res;
}

let app: web.App = web.app();
print(app.get("/visit", visit));
print(app.get("/rotate", rotate));
print(app.get("/logout", logout));

let r1: web.Response = app.handle_request("GET", "/visit", "");
print(r1.status());
let sid: str = r1.cookie_pair("bolide_session");
print(sid);
r1.free();

let r2: web.Response = app.handle_request_with_headers("GET", "/visit", "", "Cookie: theme=light; " + sid);
print(r2.status());
r2.free();

let r3: web.Response = app.handle_request_with_headers("GET", "/rotate", "", "Cookie: " + sid);
print(r3.status());
let sid2: str = r3.cookie_pair("bolide_session");
print(sid2);
r3.free();

let r4: web.Response = app.handle_request_with_headers("GET", "/logout", "", "Cookie: " + sid2);
print(r4.status());
print(r4.cookie_pair("bolide_session"));
r4.free();

app.free();
print("web session tests completed");
