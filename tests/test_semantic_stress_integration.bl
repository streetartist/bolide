// Cross-feature stress test for function values, closure RC captures, ADT fields,
// and finally/order interactions.

enum Handler {
    One(func(int) -> int),
    Tagged(str, func(int) -> int),
}

fn inc(x: int) -> int {
    return x + 1;
}

fn double(x: int) -> int {
    return x * 2;
}

fn make_adder(n: int) -> func(int) -> int {
    return fn(x: int) -> int {
        return x + n;
    };
}

fn make_list_accumulator(seed: int) -> func(int) -> int {
    let xs: list<int> = [seed];
    return fn(v: int) -> int {
        xs.push(v);
        return xs.len() * 100 + xs[0] * 10 + v;
    };
}

fn make_dict_accumulator(seed: int) -> func(str, int) -> int {
    let d: dict<str, int> = {"seed": seed};
    return fn(k: str, v: int) -> int {
        d[k] = v;
        return d.get("seed") * 100 + d.get(k);
    };
}

fn choose(flag: int, a: func(int) -> int, b: func(int) -> int) -> func(int) -> int {
    if flag == 1 {
        return a;
    }
    return b;
}

fn id_func(f: func(int) -> int) -> func(int) -> int {
    return f;
}

fn check(name: str, got: int, want: int) {
    if got == want {
        print("ok " + name);
    } else {
        print("FAIL " + name + " got=" + str(got) + " want=" + str(want));
    }
}

let list_acc = make_list_accumulator(3);
check("closure captures list first", list_acc(4), 234);
check("closure captures list second", list_acc(5), 335);

let dict_acc = make_dict_accumulator(7);
check("closure captures dict first", dict_acc("a", 8), 708);
check("closure captures dict second", dict_acc("b", 9), 709);

let direct_adder = make_adder(10);
check("direct closure return", direct_adder(5), 15);
let id_adder = id_func(make_adder(10));
check("id closure param return", id_adder(5), 15);

let picked = choose(1, make_adder(10), inc);
check("choose closure param", picked(5), 15);
let picked_raw = choose(0, make_adder(10), double);
check("choose raw param wrapped", picked_raw(5), 10);

let h1: Handler = Handler.One(make_adder(20));
match h1 {
    Handler.One(f) => {
        check("adt closure function field", f(3), 23);
    },
    Handler.Tagged(name, f) => {
        print("FAIL wrong adt arm " + name);
    },
}

let h2: Handler = Handler.Tagged("raw", inc);
match h2 {
    Handler.One(f) => {
        print("FAIL wrong adt arm one");
    },
    Handler.Tagged(name, f) => {
        check("adt raw function field", f(name.len()), 4);
    },
}

let order_log: int = 0;
fn mark(d: int) {
    order_log = order_log * 10 + d;
}

fn finally_with_closure(f: func(int) -> int) -> int {
    try {
        mark(1);
        return f(6);
    } catch (e: int) {
        mark(8);
    } finally {
        mark(2);
    }
}

check("finally return closure result", finally_with_closure(make_adder(30)), 36);
check("finally return closure order", order_log, 12);

print("stress integration done");
