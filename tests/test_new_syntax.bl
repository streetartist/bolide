// 新语法特性综合测试

// 1. 关键字词边界：以关键字为前缀的标识符
let notable: int = 5;
let android: int = 10;
let orbit: int = notable + android;
let information: int = orbit * 2;
print(information);  // 30

// 2. not 不再误吞标识符前缀
let flag: bool = true;
if not flag {
    print("wrong");
} else {
    print("not ok");  // 应输出
}

// 3. 字符串转义
print("escaped: \"quoted\" and backslash \\ done");
print("line1\nline2\ttabbed");

// 4. 复合赋值
let x: int = 10;
x += 5;
print(x);   // 15
x -= 3;
print(x);   // 12
x *= 2;
print(x);   // 24
x /= 4;
print(x);   // 6
x %= 4;
print(x);   // 2

// 5. break / continue
let total: int = 0;
for i in range(10) {
    if i == 3 {
        continue;
    }
    if i == 6 {
        break;
    }
    total += i;
}
print(total);  // 0+1+2+4+5 = 12

let n: int = 0;
while true {
    n += 1;
    if n >= 5 {
        break;
    }
}
print(n);  // 5

// 嵌套循环中的 break 只跳出内层
let count: int = 0;
for i in range(3) {
    for j in range(10) {
        if j == 2 {
            break;
        }
        count += 1;
    }
}
print(count);  // 3 * 2 = 6

// 列表迭代里的 continue/break
let nums: list<int> = [1, 2, 3, 4, 5, 6];
let acc: int = 0;
for v in nums {
    if v == 2 {
        continue;
    }
    if v == 5 {
        break;
    }
    acc += v;
}
print(acc);  // 1+3+4 = 8

// 6. 尾随逗号
let lst: list<int> = [1, 2, 3,];
print(lst.len());  // 3
let d: dict<str, int> = {"a": 1, "b": 2,};
print(d.len());  // 2

// 7. 数字下划线分隔
let big_num: int = 1_000_000;
print(big_num);  // 1000000

// 8. 比较不可链式（a < b < c 现在是语法错误，这里只验证单层比较仍正常）
let cmp_ok: bool = 1 < 2;
if cmp_ok {
    print("cmp ok");
}
