fn v3(x: float, y: float, z: float) -> (float, float, float) {
    return (x, y, z);
}

fn vadd(a: (float, float, float), b: (float, float, float)) -> (float, float, float) {
    return (a[0] + b[0], a[1] + b[1], a[2] + b[2]);
}

let c: (float, float, float) = vadd(v3(1.0, 2.0, 3.0), v3(4.0, 5.0, 6.0));
print(c[0]);
print("\n");
