// Bolide 语法定义 (PEG)
// 使用 {} 块语法，类似 Rust

// 空白和注释
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "//" ~ (!"\n" ~ ANY)* | "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

// 标识符字符（用于关键字词边界守卫）
id_char = _{ ASCII_ALPHANUMERIC | "_" }

// 带词边界的关键字（原子规则，避免 "or"/"not" 等误匹配标识符前缀）
kw_or    = @{ "or" ~ !id_char }
kw_and   = @{ "and" ~ !id_char }
kw_in    = @{ "in" ~ !id_char }
kw_as    = @{ "as" ~ !id_char }
kw_from  = @{ "from" ~ !id_char }
kw_await  = @{ "await"  ~ !id_char }
kw_spawn  = @{ "spawn"  ~ !id_char }
kw_thread = @{ "thread" ~ !id_char }
kw_inline = @{ "inline" ~ !id_char }
kw_throws = @{ "throws" ~ !id_char }
kw_let    = @{ "let"    ~ !id_char }
kw_var    = @{ "var"    ~ !id_char }
// 必须词边界：否则 "dynamic" 会被拆成 dyn + amic
kw_dyn    = @{ "dyn"    ~ !id_char }

// 程序入口
program = { SOI ~ (statement)* ~ EOI }

// 语句
statement = {
    extern_block |
    impl_from_block |
    impl_trait_block |
    trait_def |
    macro_def |
    attr_macro_def |
    comptime_fn |
    func_def |
    enum_def |
    class_def |
    value_def |
    if_stmt |
    while_stmt |
    for_stmt |
    break_stmt |
    continue_stmt |
    throw_stmt |
    yield_stmt |
    try_stmt |
    with_stmt |
    match_stmt |
    pool_stmt |
    await_scope_stmt |
    spawn_select_stmt |
    select_stmt |
    return_stmt |
    import_stmt |
    // 宏模板内重复块: $( stmt; ... )*  （须在 var/expr 前，避免 `$` 歧义）
    macro_rep_stmt |
    var_decl |
    assign_stmt |
    expr_stmt
}

// 模板体重复：$( print($x); )* 或 $( let $f = ...; )+
macro_rep_stmt = { "$" ~ "(" ~ statement+ ~ ")" ~ macro_rep_op }

// 编译期函数（仅 int/bool/str 纯计算，展开期可调用）
comptime_fn = {
    "comptime" ~ "fn" ~ ident ~ "(" ~ comptime_param_list? ~ ")" ~ ("->" ~ type_expr)? ~ block
}
comptime_param_list = { comptime_param ~ ("," ~ comptime_param)* ~ ","? }
comptime_param = { ident ~ ":" ~ type_expr }

// 属性: @derive(Debug, Eq) / @test
attr = { "@" ~ ident ~ ("(" ~ attr_arg_list? ~ ")")? }
attr_arg_list = { attr_arg ~ ("," ~ attr_arg)* ~ ","? }
attr_arg = { ident | string_lit | int_lit }

// 声明式宏: macro name($x:expr) { ... }  或 multi-arm
// export macro name { (...) => { ... }, ... }
macro_def = {
    export_keyword? ~ "macro" ~ ident ~ (
        macro_single
      | "{" ~ macro_arm+ ~ "}"
    )
}
macro_single = { macro_pattern ~ macro_body_block }
macro_arm = { macro_pattern ~ "=>" ~ macro_body_block ~ ","? }
macro_body_block = { quote_block | block }
// quote { ... } 模板块（与裸 block 等价，语义上标明模板）
quote_block = { "quote" ~ block }

// 模式: ($x:expr)  ($a:ident = $b:expr)  ($x:expr $(, $rest:expr)*)
macro_pattern = { "(" ~ macro_pat_list? ~ ")" }
macro_pat_list = { macro_pat_piece ~ (macro_pat_piece)* }
// 片段之间的分隔：逗号，或重复 $(...)*/+
macro_pat_piece = { macro_rep | macro_sep_bind | macro_eq_bind | macro_bind }
macro_sep_bind = { "," ~ (macro_rep | macro_eq_bind | macro_bind) }
macro_eq_bind = { dollar_bind ~ "=" ~ dollar_bind }
macro_bind = { dollar_bind }
// $(, $rest:expr)*   或  $($x:expr),*
macro_rep = {
    "$" ~ "(" ~ macro_rep_inner ~ ")" ~ macro_rep_op
}
macro_rep_inner = {
    // 前导分隔: , $x:expr
    ("," | ";") ~ macro_bind
  | macro_bind ~ (("," | ";") ~ macro_bind)*
  | macro_bind
}
macro_rep_op = @{ "*" | "+" }
dollar_bind = { "$" ~ ident ~ (":" ~ frag_spec)? }
frag_spec = @{
    ("expr" | "ident" | "lit" | "block" | "type" | "path" | "stmt" | "tt" | "item") ~ !id_char
}

// 属性宏定义（高级）: attr macro name($item:item, ...) { ... }
// 第一阶段解析为定义节点；展开器对内置 derive/test 特殊处理，用户 attr macro 走模板
attr_macro_def = {
    export_keyword? ~ "attr" ~ "macro" ~ ident ~ macro_pattern ~ macro_body_block
}

// 宏调用: name!(...)  path.name!(...)  name! { ... }
// 必须带 !，且 ! 后紧跟 ( 或 {
macro_invoke = {
    macro_path ~ "!" ~ (macro_paren_args | macro_brace_args)
}
macro_path = { ident ~ ("." ~ ident)* }
macro_paren_args = { "(" ~ macro_arg_list? ~ ")" }
macro_brace_args = { "{" ~ statement* ~ "}" }
macro_arg_list = { macro_arg ~ ("," ~ macro_arg)* ~ ","? }
// named: ident = expr（用于 $a:ident = $b:expr 模式）；否则表达式
macro_arg = { macro_named_arg | expr }
macro_named_arg = { ident ~ "=" ~ expr }

// 模板拼接: $name 或 $name:src / :line / :file / :stringify
splice = { "$" ~ ident ~ (":" ~ splice_meta)? }
splice_meta = @{ ("src" | "stringify" | "line" | "file") ~ !id_char }

// impl From<Src> for Dst { fn from(e: Src) -> Dst { ... } }
impl_from_block = {
    "impl" ~ "From" ~ "<" ~ type_expr ~ ">" ~ "for" ~ type_expr ~ "{" ~
        "fn" ~ "from" ~ "(" ~ ident ~ ":" ~ type_expr ~ ")" ~ ("->" ~ type_expr)? ~ block ~
    "}"
}

// trait Drawable { ... }
// trait Count: Drawable { ... }          // 父 trait（supertrait）
// trait A: B + C { ... }
trait_def = {
    attr* ~ "trait" ~ ident ~ trait_supers? ~ "{" ~ trait_member* ~ "}"
}
trait_supers = { ":" ~ ident ~ ("+" ~ ident)* }
trait_member = { trait_method_default | trait_method_req }
// 带默认实现
trait_method_default = { func_def }
// 抽象/必须实现（无方法体）
trait_method_req = {
    "fn" ~ ident ~ "(" ~ param_list? ~ ")" ~ ("->" ~ type_expr)? ~ ";"
}

// impl Drawable for Circle { fn draw() { ... } }
impl_trait_block = {
    "impl" ~ ident ~ "for" ~ ident ~ "{" ~ method_def* ~ "}"
}

value_def = { attr* ~ "value" ~ ident ~ "{" ~ value_fields ~ "}" }
value_fields = { value_field* }
value_field = { ident ~ ":" ~ type_expr ~ ";" }

throw_stmt = { "throw" ~ expr ~ ";" }
// 生成器：yield expr;  （含 yield 的函数脱糖为 list 构建）
yield_stmt = { "yield" ~ expr ~ ";" }
try_stmt  = { "try" ~ block ~ catch_clause+ ~ finally? }
catch_clause = { "catch" ~ "(" ~ ident ~ ":" ~ type_expr ~ ")" ~ block }
finally = { "finally" ~ !id_char ~ block }

// 上下文管理器（Python with）:
//   with mgr() { ... }
//   with mgr() as f { ... }
//   with a() as x, b() as y { ... }
with_stmt = { "with" ~ with_item_list ~ block }
with_item_list = { with_item ~ ("," ~ with_item)* ~ ","? }
with_item = { expr ~ (kw_as ~ ident)? }

match_stmt = { "match" ~ expr ~ "{" ~ match_arm* ~ "}" }
match_arm = { pattern ~ "=>" ~ block ~ ","? }
pattern = {
    variant_pattern
  | tuple_pattern
  | wildcard_pattern
  | none_pattern
  | bool_pattern
  | string_pattern
  | int_pattern
  | bind_pattern
}
variant_pattern = { (ident ~ ".")? ~ ident ~ "(" ~ (pattern ~ ("," ~ pattern)* ~ ","?)? ~ ")" }
tuple_pattern = { "(" ~ pattern ~ ("," ~ pattern)+ ~ ","? ~ ")" }
wildcard_pattern = @{ "_" ~ !id_char }
int_pattern = { int_lit }
string_pattern = { string_lit }
bool_pattern = { bool_lit }
none_pattern = { none_lit }
bind_pattern = { ident }

// 导入语句
import_stmt = { "import" ~ (string_lit | module_path) ~ (kw_as ~ ident)? ~ ";" }
module_path = { ident ~ ("." ~ ident)* }

// FFI extern 块
extern_block = { "extern" ~ string_lit ~ "{" ~ extern_decl* ~ "}" }
extern_decl = { extern_func | extern_struct | extern_typedef }
extern_func = { "fn" ~ ident ~ "(" ~ extern_param_list? ~ variadic? ~ ")" ~ ("->" ~ c_type)? ~ ";" }
extern_param_list = { extern_param ~ ("," ~ extern_param)* ~ ","? }
extern_param = { ident ~ ":" ~ c_type }
variadic = { "," ~ "..." }
extern_struct = { "struct" ~ ident ~ "{" ~ extern_field* ~ "}" }
extern_field = { ident ~ ":" ~ c_type ~ ";" }
extern_typedef = { "type" ~ ident ~ "=" ~ c_type ~ ";" }

// 函数定义（支持 async）
// 生命周期注解: fn foo(ref x: bigint) -> str from x
// 属性由 attributed_item 挂载，或单独出现在 method_def 前
// fn_name: 普通 ident，或宏模板名 get_$field / $field
func_def = {
    attr* ~ export_keyword? ~ async_keyword? ~ inline? ~ "fn" ~ fn_name ~ generic_param_list? ~ "(" ~ param_list? ~ ")" ~ throws_clause? ~ ("->" ~ type_expr)? ~ lifetime_clause? ~ block
}
fn_name = { splice | templated_ident | ident }
// 必须含 $，如 get_$field
templated_ident = @{
    (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_" | "$")* ~ "$" ~ (ASCII_ALPHANUMERIC | "_" | "$")+
}
inline = @{ "inline" ~ !id_char }
async_keyword = { "async" }
export_keyword = { "export" }
// <T> | <T: Drawable> | <T: A + B, U: C>
generic_param_list = { "<" ~ generic_param ~ ("," ~ generic_param)* ~ ","? ~ ">" }
generic_param = { ident ~ (":" ~ trait_bound_list)? }
trait_bound_list = { ident ~ ("+" ~ ident)* }
throws_clause = { kw_throws ~ type_expr ~ ("," ~ type_expr)* ~ ","? }
param_list = { param ~ ("," ~ param)* ~ ","? }
param = { kw_variadic_param | variadic_param | normal_param }
normal_param = { mode_param | plain_param }
mode_param = { param_mode ~ ident ~ ":" ~ type_expr ~ ("=" ~ expr)? }
plain_param = { ident ~ ":" ~ type_expr ~ ("=" ~ expr)? }
variadic_param = { "*" ~ ident ~ ":" ~ type_expr }
kw_variadic_param = { "**" ~ ident ~ ":" ~ type_expr }
param_mode = { "owned" | "ref" }
// 生命周期依赖子句: from x 或 from x, y
lifetime_clause = { kw_from ~ ident ~ ("," ~ ident)* }

// 类定义
// class Child: Primary { }              — 单继承
// class Child: Primary, Mixin1, Mixin2  — 主父类 + 无字段 mixin（多继承行为）
class_def = {
    attr* ~ "class" ~ ident ~ (":" ~ class_parents)? ~ "{" ~ class_body ~ "}"
}
class_parents = { ident ~ ("," ~ ident)* }
class_body = { class_member* }
class_member = { field_decl | method_def }
field_decl = { ident ~ ":" ~ type_expr ~ ("=" ~ expr)? ~ ";" }
method_def = { func_def }

// 代数数据类型
enum_def = {
    attr* ~ ("enum" | "union") ~ ident ~ generic_param_list? ~ "{" ~ enum_variant* ~ "}"
}
enum_variant = {
    ident ~ (tuple_variant_fields | struct_variant_fields)? ~ ","?
}
tuple_variant_fields = { "(" ~ (enum_variant_field ~ ("," ~ enum_variant_field)* ~ ","?)? ~ ")" }
struct_variant_fields = { "{" ~ (named_enum_variant_field ~ ("," ~ named_enum_variant_field)* ~ ","?)? ~ "}" }
enum_variant_field = { type_expr }
named_enum_variant_field = { ident ~ ":" ~ type_expr }

// 控制流
// if let Pattern = expr { ... } [elif ...] [else ...]
// if expr { ... }
if_stmt = {
    "if" ~ if_let_clause ~ block ~ elif_branch* ~ else_branch?
  | "if" ~ expr ~ block ~ elif_branch* ~ else_branch?
}
if_let_clause = { kw_let ~ pattern ~ "=" ~ expr }
elif_branch = { "elif" ~ expr ~ block }
else_branch = { "else" ~ block }

// while let Pattern = expr { ... }
// while expr { ... }
while_stmt = {
    "while" ~ while_let_clause ~ block
  | "while" ~ expr ~ block
}
while_let_clause = { kw_let ~ pattern ~ "=" ~ expr }
for_stmt = { "for" ~ ident ~ ("," ~ ident)* ~ kw_in ~ expr ~ block }

break_stmt = { "break" ~ ";" }
continue_stmt = { "continue" ~ ";" }

// 线程池块
pool_stmt = { "pool" ~ "(" ~ expr ~ ")" ~ block }

// await scope 语句: await scope { ... }
await_scope_stmt = { "await" ~ "scope" ~ block }

// 并行 select 语句: spawn select { x = task() => { ... } }
spawn_select_stmt = { kw_spawn ~ "select" ~ "{" ~ spawn_select_branch+ ~ "}" }
spawn_select_branch = { spawn_select_bind | spawn_select_expr }
spawn_select_bind = { ident ~ "=" ~ expr ~ "=>" ~ block }
spawn_select_expr = { expr ~ "=>" ~ block }

// channel select 语句
// 接收分支采用方法风格: v = ch.recv() => { ... }
select_stmt = { "select" ~ "{" ~ select_branch+ ~ "}" }
select_branch = { select_recv | select_timeout | select_default }
select_recv = { ident ~ "=" ~ ident ~ "." ~ "recv" ~ "(" ~ ")" ~ "=>" ~ block }
select_timeout = { "timeout" ~ "(" ~ expr ~ ")" ~ "=>" ~ block }
select_default = { "default" ~ "=>" ~ block }

return_stmt = { "return" ~ expr? ~ ";" }
var_kind = { kw_let | kw_var }
// let/var 支持：简单绑定、元组解构、结构字段解构
// let (a, b) = t;   let (a, _) = t;   let Point { x, y } = p;
// 宏模板中: let $name = $val;
var_decl = {
    var_kind ~ (
        destructure_binding ~ "=" ~ expr ~ ";"
      | splice ~ (":" ~ type_expr)? ~ ("=" ~ expr)? ~ ";"
      | ident ~ (":" ~ type_expr)? ~ ("=" ~ expr)? ~ ";"
    )
}
destructure_binding = { tuple_binding | struct_binding }
tuple_binding = { "(" ~ binding_elem ~ ("," ~ binding_elem)+ ~ ","? ~ ")" }
binding_elem = { discard_bind | ident }
// Point { x, y } 或 Point { x: a, y: _ }
struct_binding = { ident ~ "{" ~ struct_field_bind ~ ("," ~ struct_field_bind)* ~ ","? ~ "}" }
struct_field_bind = { ident ~ (":" ~ (discard_bind | ident))? }
discard_bind = @{ "_" ~ !id_char }

// _ = expr; 丢弃赋值（求值副作用后丢弃结果）
assign_stmt = { assign_target ~ assign_op ~ expr ~ ";" }
assign_op = @{ "+=" | "-=" | "*=" | "/=" | "%=" | ("=" ~ !"=") }
assign_target = { discard_bind | ((ident | self_lit) ~ (member | index)*) }
expr_stmt = { expr ~ ";" }


// 代码块
block = { "{" ~ statement* ~ "}" }

// 表达式
// 优先级从低到高: or > and > | > ^ > & > ==/!=/</>/<=/>= > << >> > + - > * / %
expr = { or_expr }
or_expr = { and_expr ~ (kw_or ~ and_expr)* }
and_expr = { bitor_expr ~ (kw_and ~ bitor_expr)* }
bitor_expr = { xor_expr ~ (bitor_op ~ xor_expr)* }
xor_expr = { bitand_expr ~ (xor_op ~ bitand_expr)* }
bitand_expr = { shift_expr ~ (bitand_op ~ shift_expr)* }
shift_expr = { cmp_expr ~ (shift_op ~ cmp_expr)? }
// 比较运算符不可链式（a < b < c 是语法错误，避免歧义语义）
cmp_expr = { add_expr ~ (cmp_op ~ add_expr)? }
add_expr = { mul_expr ~ (add_op ~ mul_expr)* }
mul_expr = { unary_expr ~ (mul_op ~ unary_expr)* }
unary_expr = { unary_op? ~ postfix_expr }
postfix_expr = { primary ~ (call_args | index | member | propagate_op | raise_op)* }

cmp_op = { "==" | "!=" | "<=" | ">=" | "<" | ">" }
shift_op = { "<<" | ">>" }
add_op = { "+" | "-" }
mul_op = { "*" | "/" | "%" }
bitor_op = { "|" }
xor_op = { "^" }
bitand_op = { "&" }
unary_op = @{ "-" | "!" | "not" ~ !id_char }

// 后缀操作
call_args = { "(" ~ (call_arg ~ ("," ~ call_arg)* ~ ","?)? ~ ")" }
call_arg = { kw_spread_arg | spread_arg | named_arg | expr }
kw_spread_arg = { "**" ~ expr }
spread_arg = { "*" ~ expr }
named_arg = { ident ~ (":" | ("=" ~ !"=")) ~ expr }
index = { "[" ~ (slice | expr) ~ "]" }
// 切片: start? : end? (: step?)? —— 至少含一个 ":"，与单表达式索引无歧义。
// 各段用独立规则，缺省时仍产生空 pair，便于按位置区分 start/end/step。
slice = { slice_start ~ ":" ~ slice_end ~ (":" ~ slice_step)? }
slice_start = { expr? }
slice_end = { expr? }
slice_step = { expr? }
// 宏模板中允许 self.$field
member = { "." ~ (splice | ident) }
propagate_op = { "?" }
raise_op = { "!" ~ !"=" }

// 基本表达式
// macro_invoke 必须在 ident 之前，保证 name!(...) 不会被解析成 Raise+Call
// splice 用于宏模板中的 $name
primary = {
    tuple_literal |
    "(" ~ expr ~ ")" |
    try_expr |
    spawn_all_expr |
    await_expr |
    spawn_expr |
    closure_expr |
    dict_literal |
    list_literal |
    bigint_lit |
    decimal_lit |
    float_lit |
    sci_lit |
    int_lit |
    f_string |
    string_lit |
    bool_lit |
    none_lit |
    self_lit |
    super_lit |
    value_construct |
    macro_invoke |
    comptime_expr |
    splice |
    ident
}

// 编译期常量块: comptime { stmts; last_expr; } → 展开期求值为常量
// 块内仅允许字面量与算术/逻辑，最后一条表达式语句为结果
comptime_expr = { "comptime" ~ block }

// f-string: f"text {expr} more"，{{ / }} 转义为字面 { / }
// 原子匹配整段字面量；插值内允许字符串字面量与嵌套 {}，
// 内容切分与 expr 再解析在 convert 层完成。
f_string = @{ ("f" | "F") ~ "\"" ~ f_string_body ~ "\"" }
f_string_body = @{ f_string_piece* }
f_string_piece = @{
    f_string_escape
  | f_string_dbl_lbrace
  | f_string_dbl_rbrace
  | f_string_interp
  | f_string_char
}
f_string_escape = @{ "\\" ~ ANY }
f_string_dbl_lbrace = @{ "{{" }
f_string_dbl_rbrace = @{ "}}" }
f_string_char = @{ !("\"" | "\\" | "{") ~ ANY }
// 插值：{ ... }，内部可含 "..." 字符串与嵌套花括号
f_string_interp = @{ "{" ~ f_interp_body ~ "}" }
f_interp_body = @{ f_interp_atom* }
f_interp_atom = @{
    f_interp_fstring
  | f_interp_string
  | f_interp_nested
  | f_interp_escape
  | f_interp_other
}
// 嵌套 f-string：必须先于普通字符 f，再于普通 "..." 匹配
f_interp_fstring = @{ ("f" | "F") ~ "\"" ~ f_string_body ~ "\"" }
f_interp_string = @{ "\"" ~ ("\\" ~ ANY | !"\"" ~ ANY)* ~ "\"" }
f_interp_nested = @{ "{" ~ f_interp_body ~ "}" }
f_interp_escape = @{ "\\" ~ ANY }
f_interp_other = @{ !("\"" | "{" | "}" | "\\") ~ ANY }

value_construct = { ident ~ "{" ~ value_args ~ "}" }
value_args = { value_arg ~ ("," ~ value_arg)* ~ ","? }
value_arg = { ident ~ ":" ~ expr }

// try 表达式: try { stmt* }，最后一个表达式语句作为 Ok 值；无表达式则 Ok(0)
try_expr = { "try" ~ block }

// 闭包表达式: fn(params) -> ret { body }
closure_expr = { "fn" ~ "(" ~ param_list? ~ ")" ~ ("->" ~ type_expr)? ~ block }

// await 表达式: await expr（绑定到后缀层级，await a + b 解析为 (await a) + b）
await_expr = { kw_await ~ postfix_expr }

// spawn all 表达式: spawn all { task(), task2(), ... }
// all 是上下文关键字；普通标识符、成员名、方法名仍可使用 all。
spawn_all_expr = { kw_spawn ~ "all" ~ !id_char ~ "{" ~ (expr ~ ("," ~ expr)* ~ ","?)? ~ "}" }

// self 字面量
self_lit = @{ "self" ~ !id_char }

// super 字面量（父类方法/字段访问）
super_lit = @{ "super" ~ !id_char }

// spawn 表达式: spawn func(args) / spawn thread func(args)
spawn_expr = { spawn_thread_expr | spawn_func_expr }
spawn_thread_expr = { kw_spawn ~ kw_thread ~ ident ~ call_args }
spawn_func_expr = { kw_spawn ~ ident ~ call_args }

// 字面量
list_literal = { "[" ~ (list_comprehension | list_items)? ~ "]" }
list_items = { expr ~ ("," ~ expr)* ~ ","? }
list_comprehension = { expr ~ "for" ~ ident ~ ("," ~ ident)* ~ "in" ~ expr ~ ("if" ~ expr)? }
dict_literal = { "{" ~ (dict_entry ~ ("," ~ dict_entry)* ~ ","?)? ~ "}" }
dict_entry = { expr ~ ":" ~ expr }
tuple_literal = { "(" ~ expr ~ "," ~ (expr ~ ("," ~ expr)*)? ~ ","? ~ ")" }

// 数字内部可用下划线分隔: 1_000_000
digits = _{ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* }

// bigint 字面量: 123B 或 123b
bigint_lit = @{ digits ~ ("B" | "b") }

// decimal 字面量: 123.45D 或 123.45d
decimal_lit = @{ digits ~ ("." ~ digits)? ~ ("D" | "d") }

// 普通字面量
hex_lit = @{ "0x" ~ ASCII_HEX_DIGIT ~ (ASCII_HEX_DIGIT | "_")* }
int_lit = @{ hex_lit | digits }
float_lit = @{ digits ~ (("." ~ digits ~ exponent?) | exponent) }
sci_lit = @{ digits ~ exponent }
exponent = @{ ("e" | "E") ~ ("+" | "-")? ~ digits }
// 字符串支持转义: \" \\ \n \t \r \0 等
string_lit = @{ "\"" ~ ("\\" ~ ANY | !("\"" | "\\") ~ ANY)* ~ "\"" }
bool_lit = @{ ("true" | "false") ~ !id_char }
none_lit = @{ "none" ~ !id_char }

// 类型
// dyn Trait：运行时多态（trait 对象），convert 层解析为 Type::Dyn
// 注意：dyn 必须用 kw_dyn（词边界），否则 dynamic 会被误解析为 dyn + amic
type_expr = { ref_mode? ~ (dyn_type | tuple_type | list_type | dict_type | channel_type | func_type | applied_type | basic_type) }
ref_mode = { "weak" | "unowned" }
dyn_type = { kw_dyn ~ (qualified_type | ident) }
tuple_type = { "(" ~ type_expr ~ ("," ~ type_expr)+ ~ ")" }
list_type = { "list" ~ "<" ~ type_expr ~ ">" }
dict_type = { "dict" ~ "<" ~ type_expr ~ "," ~ type_expr ~ ">" }
channel_type = { "channel" ~ "<" ~ type_expr ~ ">" }
func_type = { "func" ~ "(" ~ func_type_params? ~ ")" ~ ("->" ~ type_expr)? }
func_type_params = { type_expr ~ ("," ~ type_expr)* }
applied_type = { (qualified_type | ident) ~ "<" ~ type_expr ~ ("," ~ type_expr)* ~ ","? ~ ">" }
// 支持模块限定类型: module.ClassName
qualified_type = { ident ~ ("." ~ ident)+ }
// 内建类型名在 convert 层按字符串识别；这里统一走 ident，
// 避免 "int" 误匹配 "interval" 等标识符前缀
basic_type = { qualified_type | ident }

// 标识符
//
// Most Bolide keywords are contextual: `default`, `from`, `as`, `ref`, `weak`,
// `select`, etc. still have keyword meaning in their grammar positions, but
// should be usable as parameter names, fields, locals, and extern names.
// Only literal/receiver tokens stay globally reserved because they have
// expression-level semantics that cannot be represented as ordinary variables.
ident = @{ !reserved_ident ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

reserved_ident = {
    ("true" | "false" | "inline" | "none" | "self" | "super") ~ !(ASCII_ALPHANUMERIC | "_")
}

// C 类型系统（仅用于 extern 签名）
// 函数指针：func(...)（fn 仅用于声明/字面量）
// 平台相关：c_*；固定宽度：iN/uN/f32/f64
c_type = { c_func_ptr | c_ptr_type | c_array_type | c_basic_type }
c_ptr_type = { "*" ~ c_type }
c_array_type = { c_basic_type ~ "[" ~ int_lit ~ "]" }
c_func_ptr = { "func" ~ "(" ~ c_type_list? ~ ")" ~ ("->" ~ c_type)? }
c_type_list = { c_type ~ ("," ~ c_type)* }
c_basic_type = {
    "c_void" |
    "c_char" | "c_uchar" | "c_short" | "c_ushort" |
    "c_int" | "c_uint" | "c_long" | "c_ulong" | "c_longlong" | "c_ulonglong" |
    "c_float" | "c_double" | "c_bool" |
    "c_size_t" | "c_ptrdiff_t" |
    "i8" | "u8" | "i16" | "u16" | "i32" | "u32" | "i64" | "u64" |
    "f32" | "f64" |
    ident
}
