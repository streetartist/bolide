// Bolide arena helpers.
// Usage: import "std/arena/arena.bl" as arena;
//
// Arena is a lifetime bucket for values that can be represented as dynamic.
// It does not expose raw allocation pointers; clear/close drops the arena's
// retained references as a group.

import "std/buffer/buffer.bl" as buffer;

class Arena {
    values: list<dynamic>;
    closed: bool;

    fn keep(value: int) -> int {
        if self.closed == false {
            self.values.push(value);
        }
        return value;
    }

    fn keep(value: float) -> float {
        if self.closed == false {
            self.values.push(value);
        }
        return value;
    }

    fn keep(value: bool) -> bool {
        if self.closed == false {
            self.values.push(value);
        }
        return value;
    }

    fn keep(value: str) -> str {
        if self.closed == false {
            self.values.push(value);
        }
        return value;
    }

    fn keep(value: list<int>) -> list<int> {
        if self.closed == false {
            self.values.push(value);
        }
        return value;
    }

    fn keep(value: list<str>) -> list<str> {
        if self.closed == false {
            self.values.push(value);
        }
        return value;
    }

    fn keep(value: dict<str, dynamic>) -> dict<str, dynamic> {
        if self.closed == false {
            self.values.push(value);
        }
        return value;
    }

    fn keep(value: dynamic) -> dynamic {
        if self.closed == false {
            self.values.push(value);
        }
        return value;
    }

    fn len() -> int {
        return self.values.len();
    }

    fn is_closed() -> bool {
        return self.closed;
    }

    fn clear() {
        self.values.clear();
    }

    fn close() {
        if self.closed == false {
            self.clear();
            self.closed = true;
        }
    }
}

class BufferArena {
    inner: buffer.Buffer;
    closed: bool;

    fn len() -> int {
        return self.inner.len();
    }

    fn capacity() -> int {
        return self.inner.capacity();
    }

    fn reserve(additional: int) {
        if self.closed == false {
            self.inner.reserve(additional);
        }
    }

    fn clear() {
        if self.closed == false {
            self.inner.clear();
        }
    }

    fn push(value: str) {
        if self.closed == false {
            self.inner.push(value);
        }
    }

    fn push(value: int) {
        if self.closed == false {
            self.inner.push(value);
        }
    }

    fn push(value: float) {
        if self.closed == false {
            self.inner.push(value);
        }
    }

    fn push(value: bool) {
        if self.closed == false {
            self.inner.push(value);
        }
    }

    fn line(value: str) {
        if self.closed == false {
            self.inner.line(value);
        }
    }

    fn line(value: int) {
        if self.closed == false {
            self.inner.line(value);
        }
    }

    fn line(value: float) {
        if self.closed == false {
            self.inner.line(value);
        }
    }

    fn line(value: bool) {
        if self.closed == false {
            self.inner.line(value);
        }
    }

    fn to_string() -> str {
        if self.closed {
            return "";
        }
        return self.inner.to_string();
    }

    fn is_closed() -> bool {
        return self.closed;
    }

    fn close() {
        if self.closed == false {
            self.inner.close();
            self.closed = true;
        }
    }
}

fn new() -> Arena {
    return Arena([], false);
}

fn buffer_arena(capacity: int) -> BufferArena {
    return BufferArena(buffer.with_capacity(capacity), false);
}
