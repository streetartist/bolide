// Bolide environment standard library.
// Usage: import "std/env" as env;

extern "bolide" {
    fn bolide_env_get(key: *c_char) -> str;
    fn bolide_env_get_or(key: *c_char, fallback: *c_char) -> str;
    fn bolide_env_contains(key: *c_char) -> i64;
    fn bolide_env_set(key: *c_char, value: *c_char) -> i64;
    fn bolide_env_remove(key: *c_char) -> i64;
    fn bolide_env_args() -> list;
    fn bolide_env_vars() -> list;
    fn bolide_env_current_exe() -> str;
    fn bolide_env_temp_dir() -> str;
    fn bolide_env_home_dir() -> str;
    fn bolide_env_os() -> str;
    fn bolide_env_arch() -> str;
    fn bolide_env_family() -> str;
    fn bolide_env_exe_suffix() -> str;
    fn bolide_env_exit(code: i64);
}

fn get(key: str) -> str {
    return bolide_env_get(key);
}

fn get_or(key: str, fallback: str) -> str {
    return bolide_env_get_or(key, fallback);
}

fn contains(key: str) -> bool {
    return bolide_env_contains(key) != 0;
}

fn set(key: str, value: str) -> bool {
    return bolide_env_set(key, value) != 0;
}

fn remove(key: str) -> bool {
    return bolide_env_remove(key) != 0;
}

fn args() -> list<str> {
    return bolide_env_args();
}

fn vars() -> list<str> {
    return bolide_env_vars();
}

fn current_exe() -> str {
    return bolide_env_current_exe();
}

fn temp_dir() -> str {
    return bolide_env_temp_dir();
}

fn home_dir() -> str {
    return bolide_env_home_dir();
}

fn os() -> str {
    return bolide_env_os();
}

fn arch() -> str {
    return bolide_env_arch();
}

fn family() -> str {
    return bolide_env_family();
}

fn exe_suffix() -> str {
    return bolide_env_exe_suffix();
}

fn exit(code: int) {
    bolide_env_exit(code);
}

fn digit_value(ch: str) -> int {
    let digits: str = "0123456789";
    var i: int = 0;
    while i < digits.len() {
        if digits.char_at(i) == ch {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

/// 读取 int 环境变量；非法或缺失时返回 fallback
fn get_int(key: str, fallback: int) -> int {
    let raw: str = get(key);
    if raw == "" {
        return fallback;
    }
    var n: int = 0;
    var i: int = 0;
    var neg: bool = false;
    if raw.len() > 0 and raw.char_at(0) == "-" {
        neg = true;
        i = 1;
    }
    var any: bool = false;
    while i < raw.len() {
        let d: int = digit_value(raw.char_at(i));
        if d < 0 {
            return fallback;
        }
        n = n * 10 + d;
        any = true;
        i = i + 1;
    }
    if not any {
        return fallback;
    }
    if neg {
        return 0 - n;
    }
    return n;
}

fn get_bool(key: str, fallback: bool) -> bool {
    let raw: str = get(key).lower();
    if raw == "1" or raw == "true" or raw == "yes" or raw == "on" {
        return true;
    }
    if raw == "0" or raw == "false" or raw == "no" or raw == "off" {
        return false;
    }
    return fallback;
}

fn is_windows() -> bool {
    return family() == "windows" or os().lower().contains("windows");
}

fn is_unix() -> bool {
    return family() == "unix" or family() == "linux" or family() == "macos";
}

/// 在 temp 目录下拼路径段
fn temp_path(name: str) -> str {
    let base: str = temp_dir();
    if base.ends_with("/") or base.ends_with("\\") {
        return base + name;
    }
    if base.contains("\\") {
        return base + "\\" + name;
    }
    return base + "/" + name;
}
