// Bolide environment standard library.
// Usage: import "std/env/env.bl" as env;

extern "bolide" {
    fn bolide_env_get(key: *char) -> str;
    fn bolide_env_get_or(key: *char, fallback: *char) -> str;
    fn bolide_env_contains(key: *char) -> i64;
    fn bolide_env_set(key: *char, value: *char) -> i64;
    fn bolide_env_remove(key: *char) -> i64;
    fn bolide_env_args() -> list;
    fn bolide_env_vars() -> list;
    fn bolide_env_current_exe() -> str;
    fn bolide_env_temp_dir() -> str;
    fn bolide_env_home_dir() -> str;
    fn bolide_env_os() -> str;
    fn bolide_env_arch() -> str;
    fn bolide_env_family() -> str;
    fn bolide_env_exe_suffix() -> str;
    fn bolide_env_exit(code: i64);
}

fn get(key: str) -> str {
    return bolide_env_get(key);
}

fn get_or(key: str, fallback: str) -> str {
    return bolide_env_get_or(key, fallback);
}

fn contains(key: str) -> bool {
    return bolide_env_contains(key) != 0;
}

fn set(key: str, value: str) -> bool {
    return bolide_env_set(key, value) != 0;
}

fn remove(key: str) -> bool {
    return bolide_env_remove(key) != 0;
}

fn args() -> list<str> {
    return bolide_env_args();
}

fn vars() -> list<str> {
    return bolide_env_vars();
}

fn current_exe() -> str {
    return bolide_env_current_exe();
}

fn temp_dir() -> str {
    return bolide_env_temp_dir();
}

fn home_dir() -> str {
    return bolide_env_home_dir();
}

fn os() -> str {
    return bolide_env_os();
}

fn arch() -> str {
    return bolide_env_arch();
}

fn family() -> str {
    return bolide_env_family();
}

fn exe_suffix() -> str {
    return bolide_env_exe_suffix();
}

fn exit(code: int) {
    bolide_env_exit(code);
}
