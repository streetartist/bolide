// 日志。
// import "std/log" as log;

import "std/fs" as fs;
import "std/time" as time;

let DEBUG: int = 10;
let INFO: int = 20;
let WARN: int = 30;
let ERROR: int = 40;

var current_level: int = 20;
var output_file: str = "";
var show_time: bool = false;

fn level_name(level: int) -> str {
    if level <= DEBUG {
        return "DEBUG";
    }
    if level <= INFO {
        return "INFO";
    }
    if level <= WARN {
        return "WARN";
    }
    return "ERROR";
}

fn set_level(level: int) {
    current_level = level;
}

fn set_debug() {
    current_level = DEBUG;
}

fn set_info() {
    current_level = INFO;
}

fn set_warn() {
    current_level = WARN;
}

fn set_error() {
    current_level = ERROR;
}

fn set_file(path: str) {
    output_file = path;
}

fn clear_file() {
    output_file = "";
}

fn enable_time(on: bool) {
    show_time = on;
}

fn write(level: int, message: str) {
    if level < current_level {
        return;
    }
    var line: str = "[" + level_name(level) + "] " + message;
    if show_time {
        line = str(time.now_ms()) + " " + line;
    }
    print(line);
    if output_file != "" {
        fs.append_text(output_file, line + "\n");
    }
}

fn debug(message: str) {
    write(DEBUG, message);
}

fn info(message: str) {
    write(INFO, message);
}

fn warn(message: str) {
    write(WARN, message);
}

fn error(message: str) {
    write(ERROR, message);
}

/// 格式：key=value 附加字段
fn info_kv(message: str, key: str, value: str) {
    info(message + " " + key + "=" + value);
}

fn error_kv(message: str, key: str, value: str) {
    error(message + " " + key + "=" + value);
}
