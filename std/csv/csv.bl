// Bolide CSV helper library.
// Usage: import "std/csv/csv.bl" as csv;

fn escape(value: str) -> str {
    if value.contains(",") or value.contains("\"") or value.contains("\n") or value.contains("\r") {
        return "\"" + value.replace("\"", "\"\"") + "\"";
    }
    return value;
}

fn line(values: list<str>) -> str {
    let out: str = "";
    for i in range(values.len()) {
        if i > 0 {
            out = out + ",";
        }
        out = out + escape(values[i]);
    }
    return out;
}

fn parse_line(value: str) -> list<str> {
    let row: list<str> = [];
    let field: str = "";
    let in_quotes: bool = false;
    let i: int = 0;
    while i < value.len() {
        let ch: str = value.char_at(i);
        if in_quotes {
            if ch == "\"" {
                if i + 1 < value.len() and value.char_at(i + 1) == "\"" {
                    field = field + "\"";
                    i = i + 2;
                } else {
                    in_quotes = false;
                    i = i + 1;
                }
            } else {
                field = field + ch;
                i = i + 1;
            }
        } else {
            if ch == "\"" {
                in_quotes = true;
                i = i + 1;
            } elif ch == "," {
                row.push(field);
                field = "";
                i = i + 1;
            } else {
                field = field + ch;
                i = i + 1;
            }
        }
    }
    row.push(field);
    return row;
}

fn parse(text: str) -> list<list<str>> {
    let rows: list<list<str>> = [];
    let row: list<str> = [];
    let field: str = "";
    let in_quotes: bool = false;
    let i: int = 0;

    while i < text.len() {
        let ch: str = text.char_at(i);
        if in_quotes {
            if ch == "\"" {
                if i + 1 < text.len() and text.char_at(i + 1) == "\"" {
                    field = field + "\"";
                    i = i + 2;
                } else {
                    in_quotes = false;
                    i = i + 1;
                }
            } else {
                field = field + ch;
                i = i + 1;
            }
        } else {
            if ch == "\"" {
                in_quotes = true;
                i = i + 1;
            } elif ch == "," {
                row.push(field);
                field = "";
                i = i + 1;
            } elif ch == "\n" {
                row.push(field);
                rows.push(row);
                row = [];
                field = "";
                i = i + 1;
            } elif ch == "\r" {
                i = i + 1;
            } else {
                field = field + ch;
                i = i + 1;
            }
        }
    }

    if field != "" or row.len() > 0 or text.ends_with(",") {
        row.push(field);
        rows.push(row);
    }
    return rows;
}

fn stringify(rows: list<list<str>>) -> str {
    let out: str = "";
    for i in range(rows.len()) {
        if i > 0 {
            out = out + "\n";
        }
        out = out + line(rows[i]);
    }
    return out;
}
