// Bolide UUID and id helper library.
// Usage: import "std/uuid/uuid.bl" as uuid;

import "std/random/random.bl" as random;

let hex_chars: str = "0123456789abcdef";
let id_chars: str = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";

fn hex_random() -> str {
    return hex_chars.char_at(random.range(0, 16));
}

fn random_hex(count: int) -> str {
    let out: str = "";
    for i in range(count) {
        out = out + hex_random();
    }
    return out;
}

fn variant_nibble() -> str {
    return "89ab".char_at(random.range(0, 4));
}

fn v4() -> str {
    return random_hex(8)
        + "-"
        + random_hex(4)
        + "-4"
        + random_hex(3)
        + "-"
        + variant_nibble()
        + random_hex(3)
        + "-"
        + random_hex(12);
}

fn compact_v4() -> str {
    return random_hex(12) + "4" + random_hex(3) + variant_nibble() + random_hex(15);
}

fn short_id(length: int) -> str {
    if length <= 0 {
        return "";
    }
    let out: str = "";
    for i in range(length) {
        out = out + id_chars.char_at(random.range(0, id_chars.len()));
    }
    return out;
}

fn is_hex(ch: str) -> bool {
    return hex_chars.contains(ch.lower());
}

fn is_v4(value: str) -> bool {
    if value.len() != 36 {
        return false;
    }
    if value.char_at(8) != "-" or value.char_at(13) != "-" or value.char_at(18) != "-" or value.char_at(23) != "-" {
        return false;
    }
    if value.char_at(14) != "4" {
        return false;
    }
    if not "89abAB".contains(value.char_at(19)) {
        return false;
    }
    for i in range(value.len()) {
        let ch: str = value.char_at(i);
        if i != 8 and i != 13 and i != 18 and i != 23 {
            if not is_hex(ch) {
                return false;
            }
        }
    }
    return true;
}
