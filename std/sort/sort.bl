// Bolide in-place sorting helpers.
// Usage: import "std/sort/sort.bl" as sort;

extern "bolide" {
    fn bolide_string_compare(a: str, b: str) -> i64;
}

fn swap(values: list<int>, a: int, b: int) {
    let tmp: int = values[a];
    values[a] = values[b];
    values[b] = tmp;
}

fn swap(values: list<float>, a: int, b: int) {
    let tmp: float = values[a];
    values[a] = values[b];
    values[b] = tmp;
}

fn swap(values: list<str>, a: int, b: int) {
    let tmp: str = values[a];
    values[a] = values[b];
    values[b] = tmp;
}

fn str_lt(a: str, b: str) -> bool {
    return bolide_string_compare(a, b) < 0;
}

fn str_gt(a: str, b: str) -> bool {
    return bolide_string_compare(a, b) > 0;
}

fn quick_int(values: list<int>, left: int, right: int) {
    if left >= right {
        return;
    }
    let i: int = left;
    let j: int = right;
    let pivot: int = values[(left + right) / 2];
    while i <= j {
        while values[i] < pivot { i = i + 1; }
        while values[j] > pivot { j = j - 1; }
        if i <= j {
            swap(values, i, j);
            i = i + 1;
            j = j - 1;
        }
    }
    if left < j { quick_int(values, left, j); }
    if i < right { quick_int(values, i, right); }
}

fn quick_float(values: list<float>, left: int, right: int) {
    if left >= right {
        return;
    }
    let i: int = left;
    let j: int = right;
    let pivot: float = values[(left + right) / 2];
    while i <= j {
        while values[i] < pivot { i = i + 1; }
        while values[j] > pivot { j = j - 1; }
        if i <= j {
            swap(values, i, j);
            i = i + 1;
            j = j - 1;
        }
    }
    if left < j { quick_float(values, left, j); }
    if i < right { quick_float(values, i, right); }
}

fn quick_str(values: list<str>, left: int, right: int) {
    if left >= right {
        return;
    }
    let i: int = left;
    let j: int = right;
    let pivot: str = values[(left + right) / 2];
    while i <= j {
        while str_lt(values[i], pivot) { i = i + 1; }
        while str_gt(values[j], pivot) { j = j - 1; }
        if i <= j {
            swap(values, i, j);
            i = i + 1;
            j = j - 1;
        }
    }
    if left < j { quick_str(values, left, j); }
    if i < right { quick_str(values, i, right); }
}

fn ints(values: list<int>) -> list<int> {
    if values.len() > 1 {
        quick_int(values, 0, values.len() - 1);
    }
    return values;
}

fn floats(values: list<float>) -> list<float> {
    if values.len() > 1 {
        quick_float(values, 0, values.len() - 1);
    }
    return values;
}

fn strings(values: list<str>) -> list<str> {
    if values.len() > 1 {
        quick_str(values, 0, values.len() - 1);
    }
    return values;
}

fn binary_search(values: list<int>, target: int) -> int {
    let lo: int = 0;
    let hi: int = values.len() - 1;
    while lo <= hi {
        let mid: int = (lo + hi) / 2;
        if values[mid] == target {
            return mid;
        }
        if values[mid] < target {
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    return -1;
}
