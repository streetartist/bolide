// Bolide GUI standard library.
// Usage: import "std/gui/gui.bl";

extern "bolide" {
    fn bolide_gui_backend() -> str;
    fn bolide_gui_run(title: str, width: i64, height: i64, view: fn(*void)) -> i64;

    fn bolide_gui_label(ui: *void, text: str);
    fn bolide_gui_heading(ui: *void, text: str);
    fn bolide_gui_small(ui: *void, text: str);
    fn bolide_gui_strong(ui: *void, text: str);
    fn bolide_gui_separator(ui: *void);
    fn bolide_gui_space(ui: *void, points: i64);
    fn bolide_gui_button(ui: *void, text: str) -> i64;
    fn bolide_gui_selectable(ui: *void, text: str, selected: i64) -> i64;
    fn bolide_gui_link(ui: *void, label: str, url: str) -> i64;
    fn bolide_gui_text_input(ui: *void, id: str, value: str) -> str;
    fn bolide_gui_password_input(ui: *void, id: str, value: str) -> str;
    fn bolide_gui_multiline_input(ui: *void, id: str, value: str, rows: i64) -> str;
    fn bolide_gui_checkbox(ui: *void, label: str, checked: i64) -> i64;
    fn bolide_gui_slider(ui: *void, label: str, value: i64, min: i64, max: i64) -> i64;
    fn bolide_gui_progress(ui: *void, value: i64, max: i64);
    fn bolide_gui_pack(ui: *void, side: str, spacing: i64, child: fn(*void));
    fn bolide_gui_row(ui: *void, child: fn(*void));
    fn bolide_gui_column(ui: *void, child: fn(*void));
    fn bolide_gui_group(ui: *void, child: fn(*void));
    fn bolide_gui_grid(ui: *void, id: str, columns: i64, striped: i64, child: fn(*void));
    fn bolide_gui_end_row(ui: *void);
    fn bolide_gui_frame(ui: *void, title: str, child: fn(*void));
    fn bolide_gui_scroll(ui: *void, id: str, max_height: i64, child: fn(*void));
    fn bolide_gui_indent(ui: *void, id: str, child: fn(*void));
    fn bolide_gui_centered(ui: *void, child: fn(*void));
    fn bolide_gui_align(ui: *void, mode: str, child: fn(*void));
    fn bolide_gui_pad(ui: *void, x: i64, y: i64, child: fn(*void));
    fn bolide_gui_width(ui: *void, points: i64, child: fn(*void));
    fn bolide_gui_height(ui: *void, points: i64, child: fn(*void));
    fn bolide_gui_size(ui: *void, width: i64, height: i64, child: fn(*void));
    fn bolide_gui_fill_width(ui: *void, child: fn(*void));
    fn bolide_gui_fill_height(ui: *void, child: fn(*void));
    fn bolide_gui_fill(ui: *void, child: fn(*void));
    fn bolide_gui_place(ui: *void, x: i64, y: i64, width: i64, height: i64, child: fn(*void));
    fn bolide_gui_collapsing(ui: *void, title: str, child: fn(*void));
    fn bolide_gui_available_width(ui: *void) -> i64;
    fn bolide_gui_available_height(ui: *void) -> i64;
    fn bolide_gui_request_repaint(ui: *void);
}

class Ui {
    handle: ptr;

    fn label(text: str) {
        bolide_gui_label(self.handle, text);
    }

    fn heading(text: str) {
        bolide_gui_heading(self.handle, text);
    }

    fn small(text: str) {
        bolide_gui_small(self.handle, text);
    }

    fn strong(text: str) {
        bolide_gui_strong(self.handle, text);
    }

    fn separator() {
        bolide_gui_separator(self.handle);
    }

    fn space(points: int) {
        bolide_gui_space(self.handle, points);
    }

    fn button(text: str) -> bool {
        return bolide_gui_button(self.handle, text) != 0;
    }

    fn selectable(text: str, selected: bool) -> bool {
        if selected {
            return bolide_gui_selectable(self.handle, text, 1) != 0;
        }
        return bolide_gui_selectable(self.handle, text, 0) != 0;
    }

    fn link(label: str, url: str) -> bool {
        return bolide_gui_link(self.handle, label, url) != 0;
    }

    fn text_input(id: str, value: str) -> str {
        return bolide_gui_text_input(self.handle, id, value);
    }

    fn password_input(id: str, value: str) -> str {
        return bolide_gui_password_input(self.handle, id, value);
    }

    fn multiline_input(id: str, value: str, rows: int) -> str {
        return bolide_gui_multiline_input(self.handle, id, value, rows);
    }

    fn checkbox(label: str, checked: bool) -> bool {
        if checked {
            return bolide_gui_checkbox(self.handle, label, 1) != 0;
        }
        return bolide_gui_checkbox(self.handle, label, 0) != 0;
    }

    fn slider(label: str, value: int, min: int, max: int) -> int {
        return bolide_gui_slider(self.handle, label, value, min, max);
    }

    fn progress(value: int, max: int) {
        bolide_gui_progress(self.handle, value, max);
    }

    fn pack(side: str, spacing: int, child: func(Ui)) {
        bolide_gui_pack(self.handle, side, spacing, child);
    }

    fn pack_top(spacing: int, child: func(Ui)) {
        bolide_gui_pack(self.handle, "top", spacing, child);
    }

    fn pack_left(spacing: int, child: func(Ui)) {
        bolide_gui_pack(self.handle, "left", spacing, child);
    }

    fn pack_right(spacing: int, child: func(Ui)) {
        bolide_gui_pack(self.handle, "right", spacing, child);
    }

    fn pack_bottom(spacing: int, child: func(Ui)) {
        bolide_gui_pack(self.handle, "bottom", spacing, child);
    }

    fn row(child: func(Ui)) {
        bolide_gui_row(self.handle, child);
    }

    fn column(child: func(Ui)) {
        bolide_gui_column(self.handle, child);
    }

    fn group(child: func(Ui)) {
        bolide_gui_group(self.handle, child);
    }

    fn grid(id: str, columns: int, striped: bool, child: func(Ui)) {
        if striped {
            bolide_gui_grid(self.handle, id, columns, 1, child);
        } else {
            bolide_gui_grid(self.handle, id, columns, 0, child);
        }
    }

    fn end_row() {
        bolide_gui_end_row(self.handle);
    }

    fn frame(title: str, child: func(Ui)) {
        bolide_gui_frame(self.handle, title, child);
    }

    fn scroll(id: str, max_height: int, child: func(Ui)) {
        bolide_gui_scroll(self.handle, id, max_height, child);
    }

    fn indent(id: str, child: func(Ui)) {
        bolide_gui_indent(self.handle, id, child);
    }

    fn centered(child: func(Ui)) {
        bolide_gui_centered(self.handle, child);
    }

    fn align(mode: str, child: func(Ui)) {
        bolide_gui_align(self.handle, mode, child);
    }

    fn left(child: func(Ui)) {
        bolide_gui_align(self.handle, "left", child);
    }

    fn right(child: func(Ui)) {
        bolide_gui_align(self.handle, "right", child);
    }

    fn pad(x: int, y: int, child: func(Ui)) {
        bolide_gui_pad(self.handle, x, y, child);
    }

    fn width(points: int, child: func(Ui)) {
        bolide_gui_width(self.handle, points, child);
    }

    fn height(points: int, child: func(Ui)) {
        bolide_gui_height(self.handle, points, child);
    }

    fn size(width: int, height: int, child: func(Ui)) {
        bolide_gui_size(self.handle, width, height, child);
    }

    fn fill_width(child: func(Ui)) {
        bolide_gui_fill_width(self.handle, child);
    }

    fn fill_height(child: func(Ui)) {
        bolide_gui_fill_height(self.handle, child);
    }

    fn fill(child: func(Ui)) {
        bolide_gui_fill(self.handle, child);
    }

    fn place(x: int, y: int, width: int, height: int, child: func(Ui)) {
        bolide_gui_place(self.handle, x, y, width, height, child);
    }

    fn collapsing(title: str, child: func(Ui)) {
        bolide_gui_collapsing(self.handle, title, child);
    }

    fn available_width() -> int {
        return bolide_gui_available_width(self.handle);
    }

    fn available_height() -> int {
        return bolide_gui_available_height(self.handle);
    }

    fn request_repaint() {
        bolide_gui_request_repaint(self.handle);
    }
}

fn backend() -> str {
    return bolide_gui_backend();
}

fn run(title: str, width: int, height: int, view: func(Ui)) -> int {
    return bolide_gui_run(title, width, height, view);
}
