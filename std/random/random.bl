// 随机数。
// import "std/random" as random;

extern "bolide" {
    fn bolide_random_seed(seed: i64);
    fn bolide_random_int(max: i64) -> i64;
    fn bolide_random_range(min: i64, max: i64) -> i64;
    fn bolide_random_float() -> f64;
    fn bolide_random_bool() -> i64;
}

fn seed(value: int) {
    bolide_random_seed(value);
}

fn rand_int(max: int) -> int {
    return bolide_random_int(max);
}

fn range(min: int, max: int) -> int {
    return bolide_random_range(min, max);
}

fn rand_float() -> float {
    return bolide_random_float();
}

fn rand_bool() -> bool {
    return bolide_random_bool() != 0;
}

fn chance(probability: float) -> bool {
    if probability <= 0.0 {
        return false;
    }
    if probability >= 1.0 {
        return true;
    }
    return rand_float() < probability;
}

fn choice_int(items: list<int>) -> int {
    if items.len() == 0 {
        return 0;
    }
    return items[rand_int(items.len())];
}

fn choice_str(items: list<str>) -> str {
    if items.len() == 0 {
        return "";
    }
    return items[rand_int(items.len())];
}

fn shuffle_ints(items: list<int>) -> list<int> {
    var out: list<int> = [];
    for v in items {
        out.push(v);
    }
    var i: int = out.len() - 1;
    while i > 0 {
        let j: int = rand_int(i + 1);
        let tmp: int = out[i];
        out[i] = out[j];
        out[j] = tmp;
        i = i - 1;
    }
    return out;
}

fn sample_ints(items: list<int>, k: int) -> list<int> {
    if k <= 0 {
        return [];
    }
    let shuffled: list<int> = shuffle_ints(items);
    if k >= shuffled.len() {
        return shuffled;
    }
    var out: list<int> = [];
    for i in range(k) {
        out.push(shuffled[i]);
    }
    return out;
}
