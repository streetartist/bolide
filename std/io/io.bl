// 流式文件写入。
// import "std/io" as io;
//
// 读文件用 std/fs（read_text / read_lines / read_bytes）。
// 本模块面向大文件追加、日志流水线等写路径。
// Writer 支持 with：with io.open_write(path) as w { w.line("..."); }

extern "bolide" {
    fn bolide_io_open_write(path: *c_char) -> *c_void;
    fn bolide_io_open_append(path: *c_char) -> *c_void;
    fn bolide_io_write(writer: *c_void, text: *c_char) -> i64;
    fn bolide_io_write_line(writer: *c_void, text: *c_char) -> i64;
    fn bolide_io_write_bytes(writer: *c_void, data: bytes) -> i64;
    fn bolide_io_flush(writer: *c_void) -> i64;
    fn bolide_io_close(writer: *c_void);
}

class Writer {
    handle: ptr;

    fn ok() -> bool {
        return self.handle != 0;
    }

    fn write(text: str) -> bool {
        return bolide_io_write(self.handle, text) != 0;
    }

    fn line(text: str) -> bool {
        return bolide_io_write_line(self.handle, text) != 0;
    }

    fn write_bytes(data: bytes) -> bool {
        return bolide_io_write_bytes(self.handle, data) != 0;
    }

    fn flush() -> bool {
        return bolide_io_flush(self.handle) != 0;
    }

    fn close() {
        if self.handle != 0 {
            bolide_io_close(self.handle);
            self.handle = 0;
        }
    }

    /// with 协议
    fn enter() -> Writer {
        return self;
    }

    fn exit() {
        self.close();
    }
}

fn open_write(path: str) -> Writer {
    return Writer(bolide_io_open_write(path));
}

fn open_append(path: str) -> Writer {
    return Writer(bolide_io_open_append(path));
}

fn write_all(path: str, text: str) -> bool {
    let w: Writer = open_write(path);
    if not w.ok() {
        return false;
    }
    let ok: bool = w.write(text);
    w.close();
    return ok;
}

fn append_line(path: str, text: str) -> bool {
    let w: Writer = open_append(path);
    if not w.ok() {
        return false;
    }
    let ok: bool = w.line(text);
    w.close();
    return ok;
}
