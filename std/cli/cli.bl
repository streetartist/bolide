// 命令行参数解析。
// import "std/cli" as cli;
//
// 示例：
//   let specs = [cli.flag("verbose", "v", "详细输出"), cli.option("file", "f", "PATH", "", "输入文件")];
//   let args = cli.parse_env(specs);
//   if args.wants_help() { print(cli.help(args.program, "demo", specs)); env.exit(0); }
//   if args.has_errors() { print(args.error_text()); env.exit(1); }

import "std/env" as env;

class Spec {
    name: str;
    short: str;
    takes_value: bool;
    value_name: str;
    default_value: str;
    help: str;
    required: bool;
}

class Args {
    program: str;
    values: dict<str, str>;
    flags: dict<str, bool>;
    positionals: list<str>;
    errors: list<str>;

    fn has(name: str) -> bool {
        return self.flags.contains(name) or self.values.contains(name);
    }

    fn flag(name: str) -> bool {
        if self.flags.contains(name) {
            return self.flags[name];
        }
        return false;
    }

    fn value(name: str) -> str {
        if self.values.contains(name) {
            return self.values[name];
        }
        return "";
    }

    fn value_or(name: str, fallback: str) -> str {
        if self.values.contains(name) {
            return self.values[name];
        }
        return fallback;
    }

    fn int_or(name: str, fallback: int) -> int {
        if not self.values.contains(name) {
            return fallback;
        }
        return parse_int_or(self.values[name], fallback);
    }

    fn bool_or(name: str, fallback: bool) -> bool {
        if self.flags.contains(name) {
            return self.flags[name];
        }
        if not self.values.contains(name) {
            return fallback;
        }
        let v: str = self.values[name].lower();
        if v == "1" or v == "true" or v == "yes" or v == "on" {
            return true;
        }
        if v == "0" or v == "false" or v == "no" or v == "off" {
            return false;
        }
        return fallback;
    }

    fn positional(index: int) -> str {
        if index >= 0 and index < self.positionals.len() {
            return self.positionals[index];
        }
        return "";
    }

    fn positional_count() -> int {
        return self.positionals.len();
    }

    fn has_errors() -> bool {
        return self.errors.len() > 0;
    }

    fn error_text() -> str {
        return join_lines(self.errors);
    }

    /// 是否请求帮助（--help / -h）
    fn wants_help() -> bool {
        return self.flag("help") or self.flag("h");
    }

    /// 是否请求版本（--version / -V）
    fn wants_version() -> bool {
        return self.flag("version") or self.flag("V");
    }

    /// 无错误且未请求帮助
    fn ok() -> bool {
        return not self.has_errors() and not self.wants_help();
    }
}

fn flag(name: str, short: str, help: str) -> Spec {
    return Spec(name, short, false, "", "", help, false);
}

fn option(name: str, short: str, value_name: str, default_value: str, help: str) -> Spec {
    return Spec(name, short, true, value_name, default_value, help, false);
}

fn required_option(name: str, short: str, value_name: str, help: str) -> Spec {
    return Spec(name, short, true, value_name, "", help, true);
}

/// 常用 --help / -h
fn help_flag() -> Spec {
    return flag("help", "h", "显示帮助");
}

/// 常用 --version / -V
fn version_flag() -> Spec {
    return flag("version", "V", "显示版本");
}

fn find_long(specs: list<Spec>, name: str) -> int {
    for i in range(specs.len()) {
        if specs[i].name == name {
            return i;
        }
    }
    return 0 - 1;
}

fn find_short(specs: list<Spec>, short: str) -> int {
    for i in range(specs.len()) {
        if specs[i].short == short {
            return i;
        }
    }
    return 0 - 1;
}

fn starts_option(token: str) -> bool {
    return token.starts_with("-") and token != "-";
}

fn digit_value(ch: str) -> int {
    let digits: str = "0123456789";
    var i: int = 0;
    while i < digits.len() {
        if digits.char_at(i) == ch {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn parse_int_or(raw: str, fallback: int) -> int {
    if raw == "" {
        return fallback;
    }
    var n: int = 0;
    var i: int = 0;
    var neg: bool = false;
    if raw.len() > 0 and raw.char_at(0) == "-" {
        neg = true;
        i = 1;
    }
    var any: bool = false;
    while i < raw.len() {
        let d: int = digit_value(raw.char_at(i));
        if d < 0 {
            return fallback;
        }
        n = n * 10 + d;
        any = true;
        i = i + 1;
    }
    if not any {
        return fallback;
    }
    if neg {
        return 0 - n;
    }
    return n;
}

fn empty_args(program: str, specs: list<Spec>) -> Args {
    var values: dict<str, str> = {};
    var flags: dict<str, bool> = {};
    var positionals: list<str> = [];
    var errors: list<str> = [];

    for spec in specs {
        if spec.takes_value {
            if spec.default_value != "" {
                values[spec.name] = spec.default_value;
            }
        } else {
            flags[spec.name] = false;
        }
    }

    return Args(program, values, flags, positionals, errors);
}

fn set_spec_value(result: Args, spec: Spec, value: str) {
    if spec.takes_value {
        result.values[spec.name] = value;
    } else {
        result.flags[spec.name] = true;
    }
}

fn parse_long_token(result: Args, specs: list<Spec>, token: str, argv: list<str>, index: int) -> int {
    let body: str = token.substring(2, token.len());
    var name: str = body;
    var inline_value: str = "";
    var has_inline_value: bool = false;
    let eq: int = body.find("=");

    if eq >= 0 {
        name = body.substring(0, eq);
        inline_value = body.substring(eq + 1, body.len());
        has_inline_value = true;
    }

    let spec_index: int = find_long(specs, name);
    if spec_index < 0 {
        result.errors.push("unknown option: --" + name);
        return index;
    }

    let spec: Spec = specs[spec_index];
    if spec.takes_value {
        if has_inline_value {
            set_spec_value(result, spec, inline_value);
            return index;
        }
        if index + 1 < argv.len() and not starts_option(argv[index + 1]) {
            set_spec_value(result, spec, argv[index + 1]);
            return index + 1;
        }
        result.errors.push("missing value for --" + spec.name);
        return index;
    }

    if has_inline_value {
        result.errors.push("flag does not take a value: --" + spec.name);
        return index;
    }
    set_spec_value(result, spec, "true");
    return index;
}

fn parse_short_group(result: Args, specs: list<Spec>, token: str, argv: list<str>, index: int) -> int {
    let body: str = token.substring(1, token.len());
    if body.len() == 0 {
        result.positionals.push(token);
        return index;
    }

    // -fVALUE 或 -f VALUE
    if body.len() > 1 {
        let first: str = body.char_at(0);
        let first_idx: int = find_short(specs, first);
        if first_idx >= 0 {
            let first_spec: Spec = specs[first_idx];
            if first_spec.takes_value {
                set_spec_value(result, first_spec, body.substring(1, body.len()));
                return index;
            }
        }
    }

    if body.len() == 1 {
        let spec_index: int = find_short(specs, body);
        if spec_index < 0 {
            result.errors.push("unknown option: -" + body);
            return index;
        }
        let spec: Spec = specs[spec_index];
        if spec.takes_value {
            if index + 1 < argv.len() and not starts_option(argv[index + 1]) {
                set_spec_value(result, spec, argv[index + 1]);
                return index + 1;
            }
            result.errors.push("missing value for -" + spec.short);
            return index;
        }
        set_spec_value(result, spec, "true");
        return index;
    }

    for i in range(body.len()) {
        let short: str = body.char_at(i);
        let spec_index: int = find_short(specs, short);
        if spec_index < 0 {
            result.errors.push("unknown option: -" + short);
        } else {
            let spec: Spec = specs[spec_index];
            if spec.takes_value {
                result.errors.push("short option group cannot contain value option: -" + short);
            } else {
                set_spec_value(result, spec, "true");
            }
        }
    }
    return index;
}

fn validate_required(result: Args, specs: list<Spec>) {
    for spec in specs {
        if spec.required and not result.values.contains(spec.name) {
            result.errors.push("missing required option: --" + spec.name);
        }
    }
}

fn parse(argv: list<str>, specs: list<Spec>) -> Args {
    var program: str = "";
    var start: int = 0;
    if argv.len() > 0 {
        program = argv[0];
        start = 1;
    }

    var result: Args = empty_args(program, specs);
    var positional_only: bool = false;
    var i: int = start;

    while i < argv.len() {
        let token: str = argv[i];
        if positional_only {
            result.positionals.push(token);
        } elif token == "--" {
            positional_only = true;
        } elif token.starts_with("--") and token.len() > 2 {
            i = parse_long_token(result, specs, token, argv, i);
        } elif token.starts_with("-") and token != "-" {
            i = parse_short_group(result, specs, token, argv, i);
        } else {
            result.positionals.push(token);
        }
        i = i + 1;
    }

    validate_required(result, specs);
    return result;
}

fn parse_values(values: list<str>, specs: list<Spec>) -> Args {
    var argv: list<str> = ["program"];
    for value in values {
        argv.push(value);
    }
    return parse(argv, specs);
}

fn parse_env(specs: list<Spec>) -> Args {
    return parse(env.args(), specs);
}

fn parse_simple(argv: list<str>) -> Args {
    var specs: list<Spec> = [];
    var result: Args = empty_args("", specs);
    var start: int = 0;
    if argv.len() > 0 {
        result.program = argv[0];
        start = 1;
    }

    var positional_only: bool = false;
    var i: int = start;
    while i < argv.len() {
        let token: str = argv[i];
        if positional_only {
            result.positionals.push(token);
        } elif token == "--" {
            positional_only = true;
        } elif token.starts_with("--") and token.len() > 2 {
            let body: str = token.substring(2, token.len());
            let eq: int = body.find("=");
            if eq >= 0 {
                let key: str = body.substring(0, eq);
                let value: str = body.substring(eq + 1, body.len());
                result.values[key] = value;
            } else {
                result.flags[body] = true;
            }
        } elif token.starts_with("-") and token.len() == 2 {
            let key: str = token.substring(1, token.len());
            result.flags[key] = true;
        } else {
            result.positionals.push(token);
        }
        i = i + 1;
    }
    return result;
}

fn join_lines(lines: list<str>) -> str {
    var out: str = "";
    for line in lines {
        if out == "" {
            out = line;
        } else {
            out = out + "\n" + line;
        }
    }
    return out;
}

fn option_usage(spec: Spec) -> str {
    var out: str = "";
    if spec.short != "" {
        out = "-" + spec.short + ", ";
    }
    out = out + "--" + spec.name;
    if spec.takes_value {
        var value_name: str = spec.value_name;
        if value_name == "" {
            value_name = "VALUE";
        }
        out = out + " <" + value_name + ">";
    }
    return out;
}

fn help(program: str, description: str, specs: list<Spec>) -> str {
    var prog: str = program;
    if prog == "" {
        prog = "program";
    }
    var out: str = "Usage: " + prog + " [options] [args...]";
    if description != "" {
        out = out + "\n\n" + description;
    }
    if specs.len() > 0 {
        out = out + "\n\nOptions:";
        for spec in specs {
            out = out + "\n  " + option_usage(spec);
            if spec.help != "" {
                out = out + "\n      " + spec.help;
            }
            if spec.default_value != "" {
                out = out + "\n      default: " + spec.default_value;
            }
            if spec.required {
                out = out + "\n      required";
            }
        }
    }
    return out;
}

/// 解析 env.args()；失败或 --help 时打印帮助并 exit
fn parse_or_exit(specs: list<Spec>, description: str) -> Args {
    let args: Args = parse_env(specs);
    if args.wants_help() {
        print(help(args.program, description, specs));
        env.exit(0);
    }
    if args.has_errors() {
        print(args.error_text());
        print("");
        print(help(args.program, description, specs));
        env.exit(1);
    }
    return args;
}
