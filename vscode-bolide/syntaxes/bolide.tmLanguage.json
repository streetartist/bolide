{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Bolide",
    "scopeName": "source.bolide",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#declarations"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#literals"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#punctuation"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.bolide",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.bolide",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.interpolated.bolide",
                    "begin": "\\b[fF]\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.bolide",
                            "match": "\\\\(?:[\"\\\\nrt0]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f_]+\\}|.)"
                        },
                        {
                            "name": "constant.character.escape.brace.bolide",
                            "match": "\\{\\{|\\}\\}"
                        },
                        {
                            "name": "meta.interpolation.bolide",
                            "begin": "\\{",
                            "end": "\\}",
                            "patterns": [
                                {
                                    "include": "#types"
                                },
                                {
                                    "include": "#literals"
                                },
                                {
                                    "include": "#keywords"
                                },
                                {
                                    "include": "#operators"
                                }
                            ]
                        }
                    ]
                },
                {
                    "name": "string.quoted.double.bolide",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.bolide",
                            "match": "\\\\(?:[\"\\\\nrt0]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f_]+\\}|.)"
                        }
                    ]
                }
            ]
        },
        "declarations": {
            "patterns": [
                {
                    "name": "meta.function.definition.bolide",
                    "match": "\\b(?:(export)\\s+)?(?:(async)\\s+)?(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": {
                            "name": "storage.modifier.export.bolide"
                        },
                        "2": {
                            "name": "storage.modifier.async.bolide"
                        },
                        "3": {
                            "name": "keyword.declaration.function.bolide"
                        },
                        "4": {
                            "name": "entity.name.function.bolide"
                        }
                    }
                },
                {
                    "name": "meta.class.definition.bolide",
                    "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.class.bolide"
                        },
                        "2": {
                            "name": "entity.name.type.class.bolide"
                        }
                    }
                },
                {
                    "name": "meta.enum.definition.bolide",
                    "match": "\\b(enum|union)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.enum.bolide"
                        },
                        "2": {
                            "name": "entity.name.type.enum.bolide"
                        }
                    }
                },
                {
                    "name": "meta.extern-struct.definition.bolide",
                    "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.struct.bolide"
                        },
                        "2": {
                            "name": "entity.name.type.struct.bolide"
                        }
                    }
                },
                {
                    "name": "meta.type-alias.definition.bolide",
                    "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.type.bolide"
                        },
                        "2": {
                            "name": "entity.name.type.alias.bolide"
                        }
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "meta.spawn-all.bolide",
                    "match": "\\b(spawn)\\s+(all)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.concurrent.spawn.bolide"
                        },
                        "2": {
                            "name": "keyword.control.concurrent.all.bolide"
                        }
                    }
                },
                {
                    "name": "meta.spawn-select.bolide",
                    "match": "\\b(spawn)\\s+(select)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.concurrent.spawn.bolide"
                        },
                        "2": {
                            "name": "keyword.control.concurrent.select.bolide"
                        }
                    }
                },
                {
                    "name": "meta.await-scope.bolide",
                    "match": "\\b(await)\\s+(scope)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.async.await.bolide"
                        },
                        "2": {
                            "name": "keyword.control.async.scope.bolide"
                        }
                    }
                },
                {
                    "name": "keyword.control.bolide",
                    "match": "\\b(if|elif|else|while|for|in|break|continue|return|import|as|throw|try|catch|finally|match|select|timeout|default)\\b"
                },
                {
                    "name": "keyword.declaration.bolide",
                    "match": "\\b(fn|let|class|extern|struct|type|export|enum|union|from|throws)\\b"
                },
                {
                    "name": "keyword.control.async.bolide",
                    "match": "\\b(async|await|spawn|thread|pool|scope)\\b"
                },
                {
                    "name": "storage.modifier.bolide",
                    "match": "\\b(owned|ref|weak|unowned)\\b"
                },
                {
                    "name": "keyword.operator.logical.bolide",
                    "match": "\\b(and|or|not)\\b"
                },
                {
                    "name": "variable.language.bolide",
                    "match": "\\b(self|super)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.primitive.bolide",
                    "match": "\\b(int|float|bool|str|bytes|bigint|decimal|dynamic|ptr|Future|Task|void)\\b"
                },
                {
                    "name": "storage.type.generic.bolide",
                    "match": "\\b(list|dict|channel|func)\\b"
                },
                {
                    "name": "storage.type.c.bolide",
                    "match": "\\b(c_void|c_char|c_uchar|c_short|c_ushort|c_int|c_uint|c_long|c_ulong|c_longlong|c_ulonglong|c_float|c_double|c_bool|c_size_t|c_ptrdiff_t|i8|u8|i16|u16|i32|u32|i64|u64|f32|f64|string)\\b"
                }
            ]
        },
        "literals": {
            "patterns": [
                {
                    "name": "constant.language.bolide",
                    "match": "\\b(true|false|none)\\b"
                },
                {
                    "name": "constant.numeric.integer.bigint.bolide",
                    "match": "\\b[0-9][0-9_]*[Bb]\\b"
                },
                {
                    "name": "constant.numeric.float.decimal.bolide",
                    "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?[Dd]\\b"
                },
                {
                    "name": "constant.numeric.integer.hex.bolide",
                    "match": "\\b0x[0-9A-Fa-f][0-9A-Fa-f_]*\\b"
                },
                {
                    "name": "constant.numeric.float.bolide",
                    "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
                },
                {
                    "name": "constant.numeric.integer.bolide",
                    "match": "\\b[0-9][0-9_]*\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "meta.method-call.bolide",
                    "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "punctuation.accessor.bolide"
                        },
                        "2": {
                            "name": "entity.name.function.method.bolide"
                        }
                    }
                },
                {
                    "name": "meta.function-call.bolide",
                    "match": "\\b(?!if\\b|while\\b|for\\b|match\\b|catch\\b|timeout\\b|spawn\\b|await\\b|fn\\b|func\\b|select\\b)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.call.bolide"
                        }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arrow.fat.bolide",
                    "match": "=>"
                },
                {
                    "name": "keyword.operator.arrow.skinny.bolide",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.assignment.compound.bolide",
                    "match": "\\+=|-=|\\*=|/=|%="
                },
                {
                    "name": "keyword.operator.bitwise.shift.bolide",
                    "match": "<<|>>"
                },
                {
                    "name": "keyword.operator.comparison.bolide",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.spread.bolide",
                    "match": "\\*\\*"
                },
                {
                    "name": "keyword.operator.bitwise.bolide",
                    "match": "\\||\\^|&"
                },
                {
                    "name": "keyword.operator.arithmetic.bolide",
                    "match": "[+*/%-]"
                },
                {
                    "name": "keyword.operator.assignment.bolide",
                    "match": "="
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.varargs.bolide",
                    "match": "\\.\\.\\."
                },
                {
                    "name": "punctuation.separator.bolide",
                    "match": "[;,:]"
                },
                {
                    "name": "punctuation.bracket.bolide",
                    "match": "[{}\\[\\]()]"
                },
                {
                    "name": "punctuation.accessor.bolide",
                    "match": "\\."
                }
            ]
        }
    }
}
