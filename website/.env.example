# --- Bolide website ---

# Database (SQLite file, relative to website/)
DATABASE_URL="file:./dev.db"

# iron-session secret: 32+ random chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD="replace-with-at-least-32-random-chars-please-please-please"

# GitHub App OAuth credentials.
# Create the App at https://github.com/settings/apps/new with:
#   Homepage URL:               https://bolide.streetartist.top
#   Callback URL:               https://bolide.streetartist.top/auth/callback
#   Request user authorization (OAuth) during installation: ON
# Then generate a client secret on the App's page and paste it below.
GITHUB_OAUTH_CLIENT_ID="Iv23lim6CDJaNWw02bQS"
GITHUB_OAUTH_CLIENT_SECRET="__FILL_IN_GITHUB_APP_CLIENT_SECRET__"

# Public site origin (used for OAuth redirect_uri and absolute URLs)
SITE_ORIGIN="https://bolide.streetartist.top"

# Webhook signing secret. Set the same value in the GitHub App's "Webhook secret".
GITHUB_WEBHOOK_SECRET="__FILL_IN_GITHUB_WEBHOOK_SECRET__"
