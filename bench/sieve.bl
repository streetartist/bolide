// Sieve of Eratosthenes for Bolide

fn sieve(limit: int) -> int {
    // list<bool> 每元素仅 1 字节
    let is_prime: list<bool> = [];
    let k: int = 0;
    while k <= limit {
        is_prime.push(true);
        k = k + 1;
    }
    is_prime[0] = false;
    is_prime[1] = false;

    let i: int = 2;
    while i * i <= limit {
        if is_prime[i] {
            let j: int = i * i;
            while j <= limit {
                is_prime[j] = false;
                j = j + i;
            }
        }
        i = i + 1;
    }

    let count: int = 0;
    let m: int = 2;
    while m <= limit {
        if is_prime[m] {
            count = count + 1;
        }
        m = m + 1;
    }
    return count;
}

print(sieve(50000000));
