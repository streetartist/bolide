// Sieve of Eratosthenes benchmark for Bolide.
//
// Workload: classic prime sieve over a large boolean (int) array. Isolates
// integer array indexing, sequential and strided memory writes, and tight
// inner loops. Very little arithmetic, so this measures list element access
// and bounds-check overhead more than ALU throughput.

import "std/env/env.bl" as env;
import "std/time/time.bl" as time;

fn arg_or(args: list<str>, index: int, fallback: int) -> int {
    if args.len() > index {
        return int(args[index]);
    }
    return fallback;
}

fn count_primes(limit: int, reps: int) -> int {
    var count: int = 0;
    var r: int = 0;
    while r < reps {
        // bulk fill：一次分配 + 批量写，避免逐 push 扩容
        var flags: list<int> = [];
        flags.resize(limit + 1, 1);

        count = 0;
        var p: int = 2;
        while p <= limit {
            if flags[p] == 1 {
                count = count + 1;
                var m: int = p + p;
                while m <= limit {
                    flags[m] = 0;
                    m = m + p;
                }
            }
            p = p + 1;
        }
        r = r + 1;
    }
    return count;
}

let args: list<str> = env.args();
let limit: int = arg_or(args, 1, 5000000);
let reps: int = arg_or(args, 2, 1);

let start: int = time.monotonic_ms();
let count: int = count_primes(limit, reps);
let elapsed: int = time.monotonic_ms() - start;

print("bolide sieve limit={} reps={} ms={} checksum={}\n".format(limit, reps, elapsed, count));
