import "../std/web/web.bl";

fn index(req: web.Request) -> web.Response {
    let res: web.Response = web.text("hello from Bolide");
    res.set_header("X-Path", req.path());
    return res;
}

fn hello(req: web.Request) -> web.Response {
    let name: str = req.path_param("name");
    return web.json("{\"hello\":\"" + name + "\"}");
}

let app: web.App = web.app();
app.set_workers(8);
app.get_async("/", index);
app.get_async("/hello/{name}", hello);

print("Bolide async hello listening on http://127.0.0.1:18082");
app.run("127.0.0.1", 18082);
