// 内存泄漏对比测试
// 对比 weak 引用和强引用在循环中的内存表现

class WeakNode {
    value: int;
    next: Option<WeakNode>;
    prev: Option<weak WeakNode>;  // weak 引用
}

fn create_weak_list() {
    let n1: WeakNode = WeakNode(1, Option.None(), Option.None());
    let n2: WeakNode = WeakNode(2, Option.None(), Option.None());
    let n3: WeakNode = WeakNode(3, Option.None(), Option.None());
    
    n1.next = Option.Some(n2);
    n2.prev = Option.Some(n1);
    n2.next = Option.Some(n3);
    n3.prev = Option.Some(n2);
}

// 大量循环测试 weak 引用
print("Testing weak reference (100000 iterations)...\n");
let i: int = 0;
while i < 1000000 {
    create_weak_list();
    if i % 20000 == 0 {
        print("Progress: ");
        print(i);
        print("/100000\n");
    }
    i = i + 1;
}

print("\nTest completed!\n");
print("If memory stayed stable, weak references are working correctly.\n");
