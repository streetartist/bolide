// ============================================================
// 3. 控制流 / Control Flow
// ============================================================

print("");
print("▶ 3. 控制流 Control Flow");
print("─────────────────────────────────────");

// if-elif-else
let x: int = 42;
if x > 50 {
    print("x > 50");
} elif x > 40 {
    print("x > 40 (走这个分支)");
} else {
    print("x <= 40");
}

// for 循环
print("for 循环 (0-4):");
for i in range(5) {
    print(i);
}

// while 循环
print("while 循环:");
let counter: int = 3;
while counter > 0 {
    print(counter);
    counter = counter - 1;
}

// ============================================================
// 4. 函数定义与调用 / Functions
// ============================================================

print("");
print("▶ 4. 函数定义 Functions");
print("─────────────────────────────────────");

// 普通函数
fn add(a: int, b: int) -> int {
    return a + b;
}

fn greet(name: str) {
    print("Hello, ");
    print(name);
}

let sum: int = add(10, 20);
print("add(10, 20) =");
print(sum);

greet("Bolide User");

// 递归函数
fn factorial(n: int) -> int {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

print("factorial(5) =");
print(factorial(5));

// fibonacci
fn fib(n: int) -> int {
    if n <= 1 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

print("fib(10) =");
print(fib(10));

// ============================================================
// 5. 参数传递模式 / Parameter Passing Modes
// ============================================================

print("");
print("▶ 5. 参数传递模式 Parameter Modes");
print("─────────────────────────────────────");

// borrow 模式 (默认): 借用参数，不转移所有权
fn borrow_mode(x: bigint) {
    print("borrow: 借用参数");
    print(x);
}

// owned 模式: 获取所有权，调用后原变量不可用
fn owned_mode(owned x: bigint) {
    print("owned: 获取所有权");
    print(x);
}

// ref 模式: 引用模式，可修改原变量
fn ref_mode(ref x: bigint) {
    print("ref: 修改前");
    print(x);
    x = x + 1B;
    print("ref: 修改后");
    print(x);
}

let bval: bigint = 1000B;
borrow_mode(bval);
print("borrow后仍可使用:");
print(bval);

ref_mode(bval);
print("ref修改后的值:");
print(bval);

let oval: bigint = 2000B;
owned_mode(oval);
// 注意：owned_mode 调用后 oval 不再可用

// ============================================================
// 6. 面向对象: 类与方法 / OOP: Classes and Methods
// ============================================================

print("");
print("▶ 6. 面向对象编程 Classes");
print("─────────────────────────────────────");

class Point {
    x: int;
    y: int;

    fn distance() -> int {
        return self.x * self.x + self.y * self.y;
    }

    fn move_by(dx: int, dy: int) {
        self.x = self.x + dx;
        self.y = self.y + dy;
    }
}

let p: Point = Point(3, 4);
print("Point(3, 4)");
print("distance^2 = ");
print(p.distance());

p.move_by(1, 1);
print("After move_by(1, 1): x=");
print(p.x);
print("y=");
print(p.y);

// ============================================================
// 7. 继承 / Inheritance
// ============================================================

print("");
print("▶ 7. 类继承 Inheritance");
print("─────────────────────────────────────");

class Animal {
    age: int;
    
    fn get_age() -> int {
        return self.age;
    }
}

class Dog: Animal {
    breed: int;   // 使用int表示品种编号
    
    fn bark() -> int {
        return 100;  // 模拟叫声
    }
}

let dog: Dog = Dog(3, 1);

print("Dog age:");
print(dog.get_age());
print("Dog bark:");
print(dog.bark());

