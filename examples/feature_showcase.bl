// ============================================================
// 9. FFI: C 语言互操作 / FFI: C Interop
// ============================================================

print("");
print("▶ 9. FFI 调用 C 库");
print("─────────────────────────────────────");

extern "dyn:c" {
    fn abs(x: c_int) -> c_int;
}

extern "dyn:m" {
    fn sqrt(x: f64) -> f64;
}

let abs_result: int = abs(-42);
print("abs(-42) =");
print(abs_result);

let sqrt_result: float = sqrt(16.0);
print("sqrt(16.0) =");
print(sqrt_result);

// ============================================================
// 10. 异步编程: async/await / Async Programming
// ============================================================

print("");
print("▶ 10. 异步编程 async/await");
print("─────────────────────────────────────");

async fn async_double(n: int) -> int {
    return n * 2;
}

async fn async_square(n: int) -> int {
    return n * n;
}

// 启动异步任务
let future1 = async_double(21);
let future2 = async_square(10);

// 等待结果
let async_r1: int = await future1;
let async_r2: int = await future2;

print("async_double(21) =");
print(async_r1);
print("async_square(10) =");
print(async_r2);

// ============================================================
// 11. 线程并发: spawn/await / Thread Concurrency
// ============================================================

print("");
print("▶ 11. 线程并发 spawn/await");
print("─────────────────────────────────────");

fn heavy_compute(x: int) -> int {
    return x * x + x;
}

// 启动多个线程
let thread1 = spawn heavy_compute(10);
let thread2 = spawn heavy_compute(20);
let thread3 = spawn heavy_compute(30);

// 等待所有线程完成
let tr1: int = await thread1;
let tr2: int = await thread2;
let tr3: int = await thread3;

print("heavy_compute(10) =");
print(tr1);
print("heavy_compute(20) =");
print(tr2);
print("heavy_compute(30) =");
print(tr3);

// ============================================================
// 12. spawn all: 并行等待 / Parallel Spawn
// ============================================================

print("");
print("▶ 12. spawn all 并行等待");
print("─────────────────────────────────────");

fn fetch_a() -> int {
    return 100;
}

fn fetch_b() -> int {
    return 200;
}

fn fetch_c() -> int {
    return 300;
}

// 并行启动所有任务并等待完成，返回元组
let all_results: (int, int, int) = spawn all {
    fetch_a(),
    fetch_b(),
    fetch_c()
};

print("spawn all results:");
print(all_results);
print(all_results[0]);
print(all_results[1]);
print(all_results[2]);

// ============================================================
// 13. spawn select: 竞争等待 / Race Condition
// ============================================================

print("");
print("▶ 13. spawn select 竞争等待");
print("─────────────────────────────────────");

fn fast_task() -> int {
    return 1;
}

fn slow_task() -> int {
    return 2;
}

// 并行启动所有任务，第一个完成的任务获胜
spawn select {
    result = fast_task() => {
        print("fast_task won:");
        print(result);
    }
    result2 = slow_task() => {
        print("slow_task won:");
        print(result2);
    }
}

// ============================================================
// 14. Channel 通道通信 / Channel Communication
// ============================================================

print("");
print("▶ 14. 通道通信 Channel");
print("─────────────────────────────────────");

// 创建通道
let ch: channel<int> = channel();

// 发送数据
ch.send(42);
ch.send(100);

// 接收数据
let msg1: int = ch.recv();
let msg2: int = ch.recv();

print("Channel received:");
print(msg1);
print(msg2);

// ============================================================
// 15. 线程池 / Thread Pool
// ============================================================

print("");
print("▶ 15. 线程池 Thread Pool");
print("─────────────────────────────────────");

fn pool_task(id: int) -> int {
    return id * 100;
}

// 创建4个工作线程的线程池
pool(4) {
    let w1 = spawn pool_task(1);
    let w2 = spawn pool_task(2);
    let w3 = spawn pool_task(3);
    let w4 = spawn pool_task(4);
    
    print("Pool task 1:");
    print(await w1);
    print("Pool task 2:");
    print(await w2);
    print("Pool task 3:");
    print(await w3);
    print("Pool task 4:");
    print(await w4);
}

// ============================================================
// 16. 线程间通道通信 / Thread Channel Communication
// ============================================================

print("");
print("▶ 16. 线程间通道通信");
print("─────────────────────────────────────");

fn sender(ch: channel<int>, value: int) -> int {
    ch.send(value);
    return value;
}

let comm_channel: channel<int> = channel();

// 在多个线程中发送数据
let sender1 = spawn sender(comm_channel, 111);
let sender2 = spawn sender(comm_channel, 222);
let sender3 = spawn sender(comm_channel, 333);

// 主线程接收
let recv1: int = comm_channel.recv();
let recv2: int = comm_channel.recv();
let recv3: int = comm_channel.recv();

print("Received from threads:");
print(recv1);
print(recv2);
print(recv3);

// 等待发送线程完成
await sender1;
await sender2;
await sender3;

// ============================================================
// 17. BigInt 大数计算 / BigInt Arithmetic
// ============================================================

print("");
print("▶ 17. 大数运算 BigInt");
print("─────────────────────────────────────");

// 大数阶乘
fn bigint_factorial(n: bigint) -> bigint {
    if n <= 1B {
        return 1B;
    }
    return n * bigint_factorial(n - 1B);
}

// 大数 Fibonacci
fn bigint_fib(n: int) -> bigint {
    if n <= 1 {
        return 1B;
    }
    let a: bigint = 0B;
    let b: bigint = 1B;
    for i in range(n) {
        let temp: bigint = a + b;
        a = b;
        b = temp;
    }
    return b;
}

print("50! =");
print(bigint_factorial(50B));

print("fib(100) =");
print(bigint_fib(100));

// ============================================================
// 18. 多线程 BigInt 计算 / Threaded BigInt
// ============================================================

print("");
print("▶ 18. 多线程大数计算");
print("─────────────────────────────────────");

fn thread_bigint_square(x: bigint) -> bigint {
    return x * x;
}

let big_a: bigint = 123456789B;
let big_b: bigint = 987654321B;

let bigint_t1 = spawn thread_bigint_square(big_a);
let bigint_t2 = spawn thread_bigint_square(big_b);

print("123456789^2 =");
print(await bigint_t1);
print("987654321^2 =");
print(await bigint_t2);

// ============================================================
// 19. 嵌套异步调用 / Nested Async
// ============================================================

print("");
print("▶ 19. 嵌套异步调用 Nested Async");
print("─────────────────────────────────────");

async fn inner_async(n: int) -> int {
    return n + 10;
}

async fn outer_async(n: int) -> int {
    let f = inner_async(n);
    let result: int = await f;
    return result * 2;
}

let nested_future = outer_async(5);
let nested_result: int = await nested_future;
print("outer_async(5) = (5+10)*2 =");
print(nested_result);

// ============================================================
// 20. 综合示例: 并发流水线 / Pipeline
// ============================================================

print("");
print("▶ 20. 并发流水线 Concurrent Pipeline");
print("─────────────────────────────────────");

fn pipeline_stage1(x: int) -> int {
    return x * 2;
}

fn pipeline_stage2(x: int) -> int {
    return x + 100;
}

fn pipeline_stage3(x: int) -> int {
    return x / 2;
}

let input: int = 50;

// Stage 1
let s1 = spawn pipeline_stage1(input);
let mid1: int = await s1;
print("Stage 1 (x*2):");
print(mid1);

// Stage 2
let s2 = spawn pipeline_stage2(mid1);
let mid2: int = await s2;
print("Stage 2 (+100):");
print(mid2);

// Stage 3
let s3 = spawn pipeline_stage3(mid2);
let final_result: int = await s3;
print("Stage 3 (/2):");
print(final_result);

// ============================================================
// 完成 / Complete
// ============================================================

print("");
print("╔══════════════════════════════════════════════════════════╗");
print("║                 All Features Demonstrated!               ║");
