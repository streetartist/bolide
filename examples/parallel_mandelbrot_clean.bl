import "std/buffer/buffer.bl" as buffer;
import "std/fs/fs.bl" as fs;
import "std/time/time.bl" as time;

fn iter_at(px: int, py: int, width: int, height: int, max_iter: int) -> int {
    let cx: float = (float(px) / float(width)) * 3.5 - 2.5;
    let cy: float = (float(py) / float(height)) * 2.0 - 1.0;
    var x: float = 0.0;
    var y: float = 0.0;
    var iter: int = 0;

    while x * x + y * y <= 4.0 and iter < max_iter {
        let next_x: float = x * x - y * y + cx;
        y = 2.0 * x * y + cy;
        x = next_x;
        iter = iter + 1;
    }

    return iter;
}

fn write_color(out: buffer.Buffer, iter: int, max_iter: int) {
    if iter >= max_iter {
        out.push("8 10 18\n");
        return;
    }

    let t: int = iter * 255 / max_iter;
    out.push(t);
    out.push(" ");
    out.push((t * t) / 255);
    out.push(" ");
    out.push(255 - t);
    out.push("\n");
}

fn render_band(y0: int, y1: int, width: int, height: int, max_iter: int) -> str {
    let out: buffer.Buffer = buffer.with_capacity((y1 - y0) * width * 12);

    for y in range(y0, y1) {
        for x in range(width) {
            write_color(out, iter_at(x, y, width, height, max_iter), max_iter);
        }
    }

    let text: str = out.to_string();
    out.close();
    return text;
}

fn render(width: int, height: int, max_iter: int) -> str {
    let step: int = height / 8;

    let parts: (str, str, str, str, str, str, str, str) = spawn all {
        render_band(0, step, width, height, max_iter),
        render_band(step, step * 2, width, height, max_iter),
        render_band(step * 2, step * 3, width, height, max_iter),
        render_band(step * 3, step * 4, width, height, max_iter),
        render_band(step * 4, step * 5, width, height, max_iter),
        render_band(step * 5, step * 6, width, height, max_iter),
        render_band(step * 6, step * 7, width, height, max_iter),
        render_band(step * 7, height, width, height, max_iter)
    };

    let out: buffer.Buffer = buffer.with_capacity(width * height * 12);
    out.push("P3\n");
    out.push(width);
    out.push(" ");
    out.push(height);
    out.push("\n255\n");

    for i in range(8) {
        out.push(parts[i]);
    }

    let image: str = out.to_string();
    out.close();
    return image;
}

let width: int = 640;
let height: int = 360;
let max_iter: int = 9000;
let output: str = "tmp/mandelbrot_clean.ppm";

fs.create_dir_all("tmp");

let start: int = time.monotonic_ms();
let image: str = render(width, height, max_iter);
let elapsed: int = time.monotonic_ms() - start;

fs.write_text(output, image);
print("rendered {}x{} in {} ms -> {}\n".format(width, height, elapsed, output));
