import "std/gui/gui.bl";

let result: int = 0;
let current: int = 0;
let op: str = "";
let fresh: bool = true;
let display: str = "0";

fn refresh_display() {
    display = str(current);
}

fn digit(value: int) {
    if fresh {
        current = value;
        fresh = false;
    } else {
        current = current * 10 + value;
    }
    refresh_display();
}

fn set_op(next: str) {
    result = current;
    op = next;
    fresh = true;
}

fn calculate() {
    if op == "+" {
        current = result + current;
    } elif op == "-" {
        current = result - current;
    } elif op == "*" {
        current = result * current;
    } elif op == "/" {
        if current != 0 {
            current = result / current;
        }
    }
    op = "";
    fresh = true;
    refresh_display();
}

fn clear() {
    result = 0;
    current = 0;
    op = "";
    fresh = true;
    display = "0";
}

fn display_panel(ui: gui.Ui) {
    ui.heading(display);
    if op != "" {
        ui.small("运算符: " + op);
    } else {
        ui.small(" ");
    }
}

fn buttons_grid(ui: gui.Ui) {
    if ui.button("7") { digit(7); }
    if ui.button("8") { digit(8); }
    if ui.button("9") { digit(9); }
    if ui.button("/") { set_op("/"); }
    ui.end_row();

    if ui.button("4") { digit(4); }
    if ui.button("5") { digit(5); }
    if ui.button("6") { digit(6); }
    if ui.button("*") { set_op("*"); }
    ui.end_row();

    if ui.button("1") { digit(1); }
    if ui.button("2") { digit(2); }
    if ui.button("3") { digit(3); }
    if ui.button("-") { set_op("-"); }
    ui.end_row();

    if ui.button("0") { digit(0); }
    if ui.button("C") { clear(); }
    if ui.button("=") { calculate(); }
    if ui.button("+") { set_op("+"); }
    ui.end_row();
}

fn buttons_panel(ui: gui.Ui) {
    ui.grid("calculator-buttons", 4, false, buttons_grid);
}

fn root(ui: gui.Ui) {
    ui.frame("", display_panel);
    ui.space(10);
    ui.frame("", buttons_panel);
}

gui.run("Bolide 计算器", 360, 420, root);
