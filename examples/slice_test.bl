// 字符串方法 + 字符串/列表/元组切片（含步长、负索引、Unicode 码点）

print("===== 字符串方法 =====");
let s: str = "Hello, World";
print(s.len());            // 12
print(s.upper());          // HELLO, WORLD
print(s.lower());          // hello, world
print(s.contains("World"));// 1
print(s.find("World"));    // 7
print(s.starts_with("Hell"));// 1
print(s.ends_with("rld")); // 1
print(s.replace("l", "L"));// HeLLo, WorLd
print(s.count("l"));       // 3

let padded: str = "  trim me  ";
print(padded.trim());      // trim me

let ab: str = "ab";
print(ab.repeat(3));       // ababab

print("===== 字符串切片（ASCII） =====");
let h: str = "Hello, World";
print(h[0:5]);             // Hello
print(h[7:]);              // World
print(h[:5]);              // Hello
print(h[::-1]);            // dlroW ,olleH
print(h[::2]);             // Hlo ol
print(h[1]);               // e
print(h[-1]);              // d

print("===== 字符串切片（Unicode 码点） =====");
let u: str = "héllo";      // 5 码点
print(u.len());            // 6 (字节数)
print(u[0:3]);             // hél (按码点)
print(u[1]);               // é
print(u[::-1]);            // olléh

print("===== split =====");
let csv: str = "a,b,c,d";
let parts: list<str> = csv.split(",");
print(parts.len());        // 4
for p in parts {
    print(p);              // a b c d
}

print("===== 列表切片 =====");
let xs: list<int> = [10, 20, 30, 40, 50];
print(xs[1:4]);            // [20, 30, 40]
print(xs[::-1]);           // [50, 40, 30, 20, 10]
print(xs[::2]);            // [10, 30, 50]
print(xs[-2:]);            // [40, 50]

print("===== 元组切片 =====");
let t: (int, int, int, int) = (1, 2, 3, 4);
let ts: (int, int) = t[1:3];
print(ts);                 // (2, 3)

print("===== done =====");
