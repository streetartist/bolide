import "std/gui/gui.bl";

let name: str = "Bolide";
let email: str = "hello@bolide.dev";
let password: str = "";
let note: str = "这里是多行文本。\n可以直接编辑内容。";
let enabled: bool = true;
let volume: int = 42;
let progress: int = 30;
let clicks: int = 0;
let status: str = "就绪";

fn header(ui: gui.Ui) {
    ui.centered(header_center);
}

fn header_center(ui: gui.Ui) {
    ui.heading("Bolide GUI");
    ui.small("跨平台 egui 后端，使用 pack/grid/place/pad 做布局");
}

fn toolbar(ui: gui.Ui) {
    if ui.button("保存") {
        status = "已保存 " + name;
    }
    if ui.button("重置") {
        name = "Bolide";
        email = "hello@bolide.dev";
        password = "";
        note = "这里是多行文本。\n可以直接编辑内容。";
        enabled = true;
        volume = 42;
        progress = 30;
        status = "已重置";
    }
    if ui.button("点击") {
        clicks = clicks + 1;
        status = "点击次数 " + str(clicks);
    }
}

fn sidebar(ui: gui.Ui) {
    ui.frame("导航", sidebar_items);
}

fn sidebar_items(ui: gui.Ui) {
    ui.strong("页面");
    if ui.button("仪表盘") {
        status = "打开仪表盘";
    }
    if ui.button("表单") {
        status = "打开表单";
    }
    if ui.button("日志") {
        status = "打开日志";
    }
    ui.separator();
    ui.small("后端: " + gui.backend());
}

fn form_grid(ui: gui.Ui) {
    ui.strong("名称");
    name = ui.text_input("name", name);
    ui.end_row();

    ui.strong("邮箱");
    email = ui.text_input("email", email);
    ui.end_row();

    ui.strong("密码");
    password = ui.password_input("password", password);
    ui.end_row();

    ui.strong("启用");
    enabled = ui.checkbox("启用功能", enabled);
    ui.end_row();

    ui.strong("音量");
    volume = ui.slider("音量", volume, 0, 100);
    ui.end_row();
}

fn form_panel(ui: gui.Ui) {
    ui.pad(6, 6, form_frame);
}

fn form_frame(ui: gui.Ui) {
    ui.frame("设置表单", form_content);
}

fn form_content(ui: gui.Ui) {
    ui.grid("settings-grid", 2, true, form_grid);
    ui.space(8);
    note = ui.multiline_input("note", note, 6);
}

fn metrics_panel(ui: gui.Ui) {
    ui.pad(6, 6, metrics_frame);
}

fn metrics_frame(ui: gui.Ui) {
    ui.frame("状态", metrics_content);
}

fn metrics_content(ui: gui.Ui) {
    ui.label("名称: " + name);
    ui.label("邮箱: " + email);
    ui.label("点击次数: " + str(clicks));
    ui.label("当前音量: " + str(volume));
    progress = ui.slider("进度", progress, 0, 100);
    ui.progress(progress, 100);
    if enabled {
        ui.small("功能已启用");
    } else {
        ui.small("功能已禁用");
    }
}

fn log_lines(ui: gui.Ui) {
    ui.label("应用启动");
    ui.label("加载 egui 后端");
    ui.label("创建窗口");
    ui.label("渲染 pack 布局");
    ui.label("渲染 grid 布局");
    ui.label("状态: " + status);
}

fn log_panel(ui: gui.Ui) {
    ui.pad(6, 6, log_frame);
}

fn log_frame(ui: gui.Ui) {
    ui.frame("日志", log_content);
}

fn log_content(ui: gui.Ui) {
    ui.scroll("log-scroll", 140, log_lines);
}

fn main_content(ui: gui.Ui) {
    ui.pack_top(10, content_stack);
}

fn content_stack(ui: gui.Ui) {
    form_panel(ui);
    metrics_panel(ui);
    log_panel(ui);
}

fn body(ui: gui.Ui) {
    ui.width(180, sidebar);
    ui.separator();
    ui.fill_width(main_content);
}

fn root(ui: gui.Ui) {
    ui.pad(10, 8, header);
    ui.separator();
    ui.pack_left(12, toolbar);
    ui.separator();
    ui.pack_left(14, body);
    ui.separator();
    ui.right(status_line);
}

fn status_line(ui: gui.Ui) {
    ui.small(status);
}

gui.run("Bolide GUI Showcase", 900, 640, root);
